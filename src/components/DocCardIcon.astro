const art = icons[icon] ?? icons['01'];
---

<span class="doc-card-icon" data-type={type} data-compact={compact ? 'true' : undefined} aria-hidden="true">
	<svg viewBox="0 0 64 64" fill="none" role="presentation" set:html={art}></svg>
</span>

<style>
	.doc-card-icon {
		--icon-color: #75e7ff;
		position: relative;
		display: grid;
		width: 58px;
		height: 58px;
		margin-top: 30px;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--icon-color) 32%, transparent);
		background:
			linear-gradient(145deg, color-mix(in srgb, var(--icon-color) 12%, transparent), rgba(4, 6, 11, .5));
		color: var(--icon-color);
		box-shadow: inset 0 0 22px color-mix(in srgb, var(--icon-color) 7%, transparent);
		transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
	}

	.doc-card-icon[data-type="Rendering"] { --icon-color: #df8dff; }
	.doc-card-icon[data-type="Scripting"] { --icon-color: #8facff; }
	.doc-card-icon[data-type="Animation"] { --icon-color: #ffae88; }
	.doc-card-icon[data-type="Engine systems"] { --icon-color: #ffd576; }
	.doc-card-icon[data-type="Contributors"] { --icon-color: #c3c8d7; }
	.doc-card-icon[data-type="Getting started"] { --icon-color: #75edbd; }

	.doc-card-icon[data-compact="true"] {
		width: 20px;
		height: 20px;
		margin: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
	}

	.doc-card-icon[data-compact="true"] svg {
		width: 17px;
		height: 17px;
		stroke-width: 2;
		filter: drop-shadow(0 0 5px color-mix(in srgb, currentColor 30%, transparent));
	}

	svg {
		width: 38px;
		height: 38px;
		overflow: visible;
		stroke: currentColor;
		stroke-width: 1.65;
		stroke-linecap: round;
		stroke-linejoin: round;
		filter: drop-shadow(0 0 7px color-mix(in srgb, currentColor 36%, transparent));
	}

	:global(.doc-card:hover) .doc-card-icon,
	:global(.doc-card:focus-visible) .doc-card-icon {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--icon-color) 70%, transparent);
		box-shadow:
			inset 0 0 26px color-mix(in srgb, var(--icon-color) 12%, transparent),
			0 0 24px color-mix(in srgb, var(--icon-color) 16%, transparent);
	}
</style>
