---
interface Props {
	variant: 'features' | 'roadmap' | 'github' | 'docs' | 'download';
}

const { variant } = Astro.props;
---

<div
	class={`page-gradient-layer page-gradient-${variant}`}
	data-page-gradient-layer
	data-gradient-speed={variant === 'roadmap' ? '0.035' : '0.03'}
	aria-hidden="true"
></div>

<script>
	const gradientLayers = document.querySelectorAll<HTMLElement>('[data-page-gradient-layer]');
	let gradientFrame = 0;

	const updateGradientParallax = () => {
		gradientFrame = 0;
		gradientLayers.forEach((layer) => {
			const parallaxSpeed = Number(layer.dataset.gradientSpeed ?? 0.03);
			layer.style.setProperty('--gradient-parallax-y', `${window.scrollY * -parallaxSpeed}px`);
		});
	};

	const scheduleGradientParallax = () => {
		if (gradientFrame) return;
		gradientFrame = window.requestAnimationFrame(updateGradientParallax);
	};

	window.addEventListener('scroll', scheduleGradientParallax, { passive: true });
	window.addEventListener('resize', scheduleGradientParallax, { passive: true });
	updateGradientParallax();
</script>

<style>
	.page-gradient-layer {
		position: fixed;
		inset: -100vh -16vw;
		z-index: 0;
		pointer-events: none;
		transform: translate3d(0, var(--gradient-parallax-y, 0px), 0);
		will-change: transform;
	}

	.page-gradient-features {
		background:
			radial-gradient(circle at 79% 39%, rgba(108, 55, 170, .18), transparent 34rem),
			radial-gradient(circle at 17% 59%, rgba(38, 91, 164, .14), transparent 36rem);
	}

	.page-gradient-roadmap {
		background:
			radial-gradient(circle at 76% 37%, rgba(118, 58, 178, .18), transparent 35rem),
			radial-gradient(circle at 23% 60%, rgba(42, 101, 177, .14), transparent 38rem);
	}

	.page-gradient-github {
		background:
			radial-gradient(circle at 20% 39%, rgba(124, 59, 177, .18), transparent 34rem),
			radial-gradient(circle at 80% 59%, rgba(36, 91, 166, .14), transparent 38rem);
	}

	.page-gradient-docs {
		background:
			radial-gradient(circle at 18% 28%, rgba(48, 102, 181, .17), transparent 35rem),
			radial-gradient(circle at 84% 48%, rgba(126, 56, 177, .18), transparent 37rem),
			radial-gradient(circle at 47% 82%, rgba(48, 82, 151, .1), transparent 31rem);
	}

	.page-gradient-download {
		background:
			radial-gradient(circle at 76% 30%, rgba(63, 123, 187, .18), transparent 35rem),
			radial-gradient(circle at 22% 62%, rgba(136, 60, 169, .18), transparent 38rem),
			radial-gradient(circle at 54% 84%, rgba(37, 103, 131, .1), transparent 30rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.page-gradient-layer {
			transform: none;
		}
	}
</style>
