---
interface Props {
	/** Identifies the current top-level page for accessible navigation. */
	current?: 'home' | 'features' | 'roadmap' | 'docs' | 'download' | 'github';
}

const { current } = Astro.props;
---

<header class="openengine-site-nav">
	<nav aria-label="Open Engine site">
		<a class="nav-brand" href="/" aria-current={current === 'home' ? 'page' : undefined}>Open Engine</a>
		<a href="/features" aria-current={current === 'features' ? 'page' : undefined}>Features</a>
		<a href="/roadmap" aria-current={current === 'roadmap' ? 'page' : undefined}>Roadmap</a>
		<a href="/download" aria-current={current === 'download' ? 'page' : undefined}>Download</a>
		<a href="/github" aria-current={current === 'github' ? 'page' : undefined}>GitHub</a>
		<a href="https://discord.gg/jyYPNTJ4P2" target="_blank" rel="noopener">Discord</a>
	</nav>
	<button class="mouse-fx-toggle" type="button" data-mouse-fx-toggle aria-pressed="true">
		<span class="mouse-fx-label">Mouse FX</span>
		<span class="mouse-fx-state" data-mouse-fx-state>On</span>
		<span class="mouse-fx-switch" aria-hidden="true"><span class="mouse-fx-thumb"></span></span>
	</button>
</header>

<script>
	const storageKey = 'openengine-mouse-fx';
	const toggle = document.querySelector<HTMLButtonElement>('[data-mouse-fx-toggle]');
	const stateLabel = toggle?.querySelector<HTMLElement>('[data-mouse-fx-state]');

	if (toggle && stateLabel) {
		let enabled = true;
		try {
			enabled = window.sessionStorage.getItem(storageKey) !== 'off';
		} catch {
			enabled = true;
		}

		const applyState = (nextEnabled: boolean, persist = false) => {
			enabled = nextEnabled;
			document.documentElement.dataset.mouseFx = enabled ? 'on' : 'off';
			toggle.setAttribute('aria-pressed', String(enabled));
			toggle.setAttribute('aria-label', enabled ? 'Turn mouse effects off' : 'Turn mouse effects on');
			stateLabel.textContent = enabled ? 'On' : 'Off';
			if (persist) {
				try { window.sessionStorage.setItem(storageKey, enabled ? 'on' : 'off'); } catch { /* Preference remains active for this page. */ }
			}
			window.dispatchEvent(new CustomEvent('openengine:mouse-fx-change', { detail: { enabled } }));
		};

		applyState(enabled);
		toggle.addEventListener('click', () => applyState(!enabled, true));
	}
</script>

<style is:global>
	.openengine-site-nav {
		--nav-pad-left: max(clamp(14px, 4.5vw, 80px), env(safe-area-inset-left, 0px));
		--nav-pad-right: max(clamp(14px, 4.5vw, 80px), env(safe-area-inset-right, 0px));

		position: sticky;
		top: 0;
		z-index: 1000;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 16px;
		flex-shrink: 0;
		box-sizing: border-box;
		margin-inline: calc(-1 * var(--nav-pad-left)) calc(-1 * var(--nav-pad-right));
		padding-inline: var(--nav-pad-left) var(--nav-pad-right);
		padding-block-start: max(clamp(14px, 3vw, 24px), env(safe-area-inset-top, 0px));
		padding-block-end: 12px;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.46), rgba(0, 0, 0, 0));
		backdrop-filter: blur(10px) saturate(1.1);
		-webkit-backdrop-filter: blur(10px) saturate(1.1);
		border-bottom: 0;
	}

	.openengine-site-nav nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 12px 20px;
	}

	.openengine-site-nav a {
		color: var(--muted);
		text-decoration: none;
		font-size: 13px;
		font-weight: 500;
		line-height: 1.55;
		text-transform: uppercase;
		letter-spacing: 0.075em;
		transition: color 0.15s ease;
	}

	.openengine-site-nav a:hover {
		color: var(--fg);
	}

	.openengine-site-nav a[aria-current='page'] {
		color: var(--fg);
	}

	.openengine-site-nav a:focus-visible {
		outline: 2px solid var(--accent-c);
		outline-offset: 3px;
		border-radius: 4px;
	}

	.mouse-fx-toggle {
		position: absolute;
		right: var(--nav-pad-right);
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 32px;
		padding: 5px 7px 5px 10px;
		border: 0;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.78);
		color: rgba(255, 255, 255, 0.78);
		font: 600 12px/1 var(--font-mono);
		letter-spacing: 0.055em;
		text-transform: uppercase;
		cursor: pointer;
		outline: none;
		transition: color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
	}

	.mouse-fx-switch {
		display: block;
		width: 28px;
		height: 16px;
		padding: 2px;
		border: 1px solid rgba(255, 255, 255, 0.34);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.16);
		transition: border-color .18s ease, background .18s ease;
	}

	.mouse-fx-state {
		display: inline-block;
		width: 2.4em;
		text-align: left;
	}

	.mouse-fx-thumb {
		display: block;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #fff;
		box-shadow: none;
		transform: translateX(12px);
		transition: transform .2s ease, background .18s ease, box-shadow .18s ease;
	}

	.mouse-fx-toggle:hover,
	.mouse-fx-toggle:focus-visible {
		color: #fff;
		background: rgba(12, 34, 45, 0.88);
		box-shadow: none;
		outline: none;
	}

	.mouse-fx-toggle[aria-pressed='false'] {
		background: rgba(0, 0, 0, 0.78);
		color: rgba(255, 255, 255, 0.48);
	}

	.mouse-fx-toggle[aria-pressed='false'] .mouse-fx-switch {
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.055);
	}

	.mouse-fx-toggle[aria-pressed='false'] .mouse-fx-thumb {
		background: #777482;
		box-shadow: none;
		transform: translateX(0);
	}

	.mouse-fx-toggle[aria-pressed='false']:hover,
	.mouse-fx-toggle[aria-pressed='false']:focus-visible {
		color: #fff;
		background: rgba(12, 34, 45, 0.88);
		box-shadow: none;
	}

	.mouse-fx-toggle:hover .mouse-fx-switch,
	.mouse-fx-toggle:focus-visible .mouse-fx-switch,
	.mouse-fx-toggle[aria-pressed='false']:hover .mouse-fx-switch,
	.mouse-fx-toggle[aria-pressed='false']:focus-visible .mouse-fx-switch {
		border-color: rgba(255, 255, 255, 0.5);
		background: rgba(255, 255, 255, 0.2);
	}

	.mouse-fx-toggle:hover .mouse-fx-thumb,
	.mouse-fx-toggle:focus-visible .mouse-fx-thumb,
	.mouse-fx-toggle[aria-pressed='false']:hover .mouse-fx-thumb,
	.mouse-fx-toggle[aria-pressed='false']:focus-visible .mouse-fx-thumb {
		background: #fff;
		box-shadow: 0 0 10px rgba(110, 231, 255, 0.75);
	}

	@media (max-width: 720px) {
		.mouse-fx-toggle {
			display: none;
		}

		.openengine-site-nav a.nav-brand {
			display: none;
		}

		.openengine-site-nav {
			gap: 10px;
		}

		.openengine-site-nav nav {
			justify-content: center;
			gap: 6px 2px;
		}

		.openengine-site-nav a {
			font-size: 11px;
			line-height: 1.52;
			letter-spacing: 0.055em;
			padding: 10px 5px;
			min-height: 44px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			border-radius: 8px;
		}

		.mouse-fx-toggle {
			position: absolute;
			top: calc(100% + 8px);
			right: max(10px, env(safe-area-inset-right, 0px));
			min-height: 32px;
			padding: 5px 7px 5px 9px;
			background: rgba(3, 7, 11, 0.92);
		}
	}

	@media (max-width: 380px) {
		.openengine-site-nav a {
			font-size: 10px;
			padding-inline: 4px;
			min-height: 40px;
		}

		.mouse-fx-toggle {
			padding-inline: 7px;
			font-size: 9px;
		}
	}

	@media (orientation: landscape) and (max-width: 940px) and (max-height: 560px) {
		.openengine-site-nav {
			padding-block-start: max(4px, env(safe-area-inset-top, 0px));
			padding-block-end: 4px;
		}

		.openengine-site-nav nav {
			gap: 2px 8px;
		}

		.openengine-site-nav a {
			min-height: 32px;
			padding: 4px 6px;
			font-size: 10px;
		}

		.mouse-fx-toggle {
			position: absolute;
			top: calc(100% + 6px);
			right: max(8px, env(safe-area-inset-right, 0px));
			min-height: 27px;
			padding: 3px 6px 3px 8px;
			font-size: 8px;
		}

		.mouse-fx-switch { width: 24px; height: 14px; }
		.mouse-fx-thumb { width: 8px; height: 8px; transform: translateX(10px); }
		.mouse-fx-toggle[aria-pressed='false'] .mouse-fx-thumb { transform: translateX(0); }
	}
</style>
