---
import Layout from '../layouts/Layout.astro';
import OpenEngineSiteNav from '../components/OpenEngineSiteNav.astro';
import OpenEngineFooter from '../components/OpenEngineFooter.astro';
import ConstellationBackground from '../components/ConstellationBackground.astro';
import PageGradientLayer from '../components/PageGradientLayer.astro';
import editorSkyEnvironment from '../assets/editor-environment.png';
import { ICONS, maskUrl } from '../lib/icons';

const markerMask = maskUrl(ICONS.featureMarker);
const listBulletMask = maskUrl(ICONS.listBullet);
const editorSections = [
	{ id: 'hierarchy', label: 'Hierarchy', kicker: '01 · Scene structure', description: 'Build a scene from visible entities: cameras, lights, volumes, terrain, and imported assets stay organized in one place.', x: '7%', y: '24%' },
	{ id: 'scene', label: 'Scene view', kicker: '02 · World preview', description: 'Author directly in the world with an interactive scene view for composition, lighting, atmosphere, and moment-to-moment iteration.', x: '48%', y: '43%' },
	{ id: 'inspector', label: 'Inspector', kicker: '03 · Precision controls', description: 'Tune the selected object through focused component controls—from transform values to physical sky, sun, moon, fog, and particles.', x: '86%', y: '27%' },
	{ id: 'assets', label: 'Asset browser', kicker: '04 · Project content', description: 'Browse project files and visual assets without leaving the editor, then bring them straight into the scene and iterate in context.', x: '47%', y: '87%' },
	{ id: 'asset-view', label: 'Asset view', kicker: '05 · Visual preview', description: 'Inspect selected materials, textures, and other visual assets in a dedicated preview before bringing them into the world.', x: '69%', y: '87%' },
	{ id: 'play-controls', label: 'Play controls', kicker: '06 · Run and iterate', description: 'Enter play mode, pause the world, or step through simulation changes while keeping the scene and editor state in view.', x: '50%', y: '8%' },
	{ id: 'top-toolbar', label: 'Top toolbar', kicker: '07 · Editor tools', description: 'Reach the editor’s primary workspace tools, view controls, and quick actions from the persistent toolbar across the top.', x: '24%', y: '8%' },
	{ id: 'layout-presets', label: 'Layout presets', kicker: '08 · Workspace layouts', description: 'Switch between saved workspace arrangements so the editor adapts to animation, authoring, asset review, and other focused tasks.', x: '50%', y: '98%' },
	{ id: 'scene-toolbar', label: 'Scene toolbar', kicker: '09 · View tools', description: 'Use the vertical scene overlay to switch authoring tools and interact directly with the world view while you build.', x: '26%', y: '38%' },
	{ id: 'transform', label: 'Transform', kicker: '10 · Spatial controls', description: 'Set local position, rotation, and scale with precise numeric controls for the selected entity.', x: '89%', y: '23%' },
	{ id: 'asset-name', label: 'Asset name', kicker: '11 · Identity', description: 'Find an asset by its project name and use it as the primary reference point while browsing content.', x: '17%', y: '84%' },
	{ id: 'asset-type', label: 'Asset type', kicker: '12 · Format', description: 'See the asset format at a glance, so materials, textures, models, and other resources stay easy to distinguish.', x: '25%', y: '84%' },
	{ id: 'asset-size', label: 'Asset size', kicker: '13 · Footprint', description: 'Review file size directly in the browser to understand an asset’s storage footprint in the project.', x: '30%', y: '84%' },
	{ id: 'asset-dimensions', label: 'Asset dimensions', kicker: '14 · Resolution', description: 'Check dimensions and other visual properties before choosing an asset for the current scene.', x: '36%', y: '84%' },
	{ id: 'asset-modified', label: 'Modified date', kicker: '15 · Recency', description: 'See when an asset was last changed, helping you identify the most current version during iteration.', x: '44%', y: '84%' },
	{ id: 'asset-status', label: 'Git status', kicker: '16 · Source control', description: 'Keep source-control state visible in the browser so changed, new, and tracked assets are clear while you work.', x: '51%', y: '84%' },
	{ id: 'asset-tag', label: 'Asset tag', kicker: '17 · Organization', description: 'Use tags to classify content and keep larger projects easier to search, filter, and manage.', x: '56%', y: '84%' },
] as const;

const editorGallery = [
	{
		image: '/images/editor-captures/editor-workspace-clean.png',
		alt: 'Open Engine editor with a sunset scene, hierarchy, smart folders, assets, and a Sky Environment inspector.',
		kicker: '01 · Live workspace',
		title: 'Scene, assets, and atmosphere',
		description: 'A full editor workspace with the scene view, project assets, and the physical sky inspector working together.',
		zones: [
			{ label: 'Scene view', x: '20%', y: '8%', width: '60%', height: '66%' },
			{ label: 'Project assets', x: '0%', y: '74%', width: '58%', height: '26%' },
			{ label: 'Inspector', x: '80%', y: '8%', width: '20%', height: '66%' },
		],
	},
	{
		image: '/images/editor-captures/material-library-workspace-clean.png',
		alt: 'Open Engine editor showing a material asset library and a textured sphere preview.',
		kicker: '02 · Material library',
		title: 'Browse materials at scale',
		description: 'Explore a visual material library in the asset browser, select an asset, and inspect it directly in the workspace.',
		zones: [
			{ label: 'Material preview', x: '20%', y: '8%', width: '60%', height: '34%' },
			{ label: 'Asset library', x: '20%', y: '42%', width: '60%', height: '58%' },
			{ label: 'Inspector', x: '80%', y: '8%', width: '20%', height: '92%' },
		],
	},
	{
		image: '/images/editor-captures/scene-authoring-workspace-clean.png',
		alt: 'Open Engine editor showing a colourful stylised scene, hierarchy, asset browser, and material inspector.',
		kicker: '03 · Scene authoring',
		title: 'Compose pixel-art worlds',
		description: 'Build stylised pixel-art scenes while keeping the hierarchy, scene, asset browser, and material controls visible for fast iteration.',
		zones: [
			{ label: 'Hierarchy', x: '0%', y: '8%', width: '20%', height: '66%' },
			{ label: 'Scene view', x: '20%', y: '8%', width: '60%', height: '66%' },
			{ label: 'Materials', x: '80%', y: '8%', width: '20%', height: '66%' },
		],
	},
	{
		image: '/images/editor-captures/material-inspector-workspace-clean.png',
		alt: 'Open Engine editor showing a jungle scene, material thumbnails, and a material preview in the Asset View.',
		kicker: '04 · Asset inspection',
		title: 'Inspect every material detail',
		description: 'Preview materials side by side with their shader properties, textures, and selected scene content.',
		zones: [
			{ label: 'Scene view', x: '20%', y: '8%', width: '60%', height: '46%' },
			{ label: 'Material browser', x: '0%', y: '54%', width: '62%', height: '46%' },
			{ label: 'Asset view', x: '62%', y: '54%', width: '18%', height: '46%' },
		],
	},
	{
		image: '/images/editor-captures/lore-version-control-clean.png',
		alt: 'Open Engine editor showing Lore version-control settings, asset status, and context menu actions.',
		kicker: '05 · Version control',
		title: 'Source control inside the editor',
		description: 'Work with Git, Lore, Subversion, and Diversion directly in the editor—keeping repository state, asset changes, diffs, history, and sync actions close to the project.',
		zones: [
			{ label: 'Provider settings', x: '0%', y: '8%', width: '20%', height: '66%' },
			{ label: 'Scene view', x: '20%', y: '8%', width: '60%', height: '66%' },
			{ label: 'Asset status', x: '0%', y: '74%', width: '58%', height: '26%' },
		],
	},
	{
		image: '/images/editor-captures/ocean-ibl-workspace-clean.png',
		alt: 'Open Engine editor showing a ship at sea with an ocean shader, reflections, and a starry dusk sky.',
		kicker: '06 · Environment rendering',
		title: 'Ocean shader & image-based lighting',
		description: 'Shape an ocean scene with reflective water, a starry sky, and image-based lighting that carries atmosphere across the world.',
		zones: [
			{ label: 'Editor toolbar', x: '0%', y: '0%', width: '100%', height: '9%' },
			{ label: 'Ocean shader', x: '0%', y: '9%', width: '78%', height: '91%' },
			{ label: 'Image-based lighting', x: '78%', y: '9%', width: '22%', height: '91%' },
		],
	},
] as const;
---

<Layout title="Features · Open Engine · openengineproject.com">
	<div class="features-page">
		<OpenEngineSiteNav current="features" />
		<PageGradientLayer variant="features" />
		<ConstellationBackground />

		<main>
			<section class="editor-tour" data-editor-tour aria-labelledby="editor-tour-heading">
				<div class="editor-tour-heading">
					<div>
						<p>Inside the editor</p>
						<h1 id="editor-tour-heading">Editor UI</h1>
					</div>
					<p class="editor-tour-instruction">Hover to explore the editor.</p>
				</div>

				<div class="editor-tour-visual">
					<div class="editor-tour-stage">
						<img src={editorSkyEnvironment.src} alt="Open Engine editor showing a moonlit fantasy landscape, hierarchy, inspector, and asset browser." class="editor-tour-image" loading="eager" decoding="async" />
						<div class="editor-magnifier" data-editor-magnifier aria-hidden="true"></div>
						<div class="editor-magnifier-label" data-editor-magnifier-label aria-hidden="true">Asset browser</div>
					</div>

					<div class="editor-details" aria-live="polite">
						{editorSections.map((section) => (
							<article class="editor-detail-card" id={`editor-panel-${section.id}`} data-editor-panel={section.id} hidden={section.id !== 'assets'}>
								<p>{section.kicker}</p>
								<h2>{section.label}</h2>
								<p>{section.description}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="editor-gallery" aria-labelledby="editor-gallery-heading">
				<div class="editor-gallery-heading">
					<div>
						<p>More of the editor</p>
						<h2 id="editor-gallery-heading">Editor features</h2>
					</div>
					<p>Hover each capture to inspect the details at 100%.</p>
				</div>
				<div class="editor-gallery-grid">
					{editorGallery.map((item) => (
						<article class="editor-gallery-card" data-gallery-card>
							<div class="editor-gallery-stage" data-gallery-stage tabindex="0" role="button" aria-label={`Open ${item.title} full size`}>
								<img src={item.image} alt={item.alt} loading="lazy" decoding="async" data-gallery-image />
								<div class="editor-gallery-zones" aria-hidden="true">
									{item.zones.map((zone) => (
										<span class="editor-gallery-zone" style={`--zone-x: ${zone.x}; --zone-y: ${zone.y}; --zone-width: ${zone.width}; --zone-height: ${zone.height};`}><span>{zone.label}</span></span>
									))}
								</div>
								<div class="editor-gallery-magnifier" data-gallery-magnifier aria-hidden="true"></div>
								<div class="editor-gallery-magnifier-label" data-gallery-magnifier-label aria-hidden="true">Editor view</div>
							</div>
							<div class="editor-gallery-copy">
								<p>{item.kicker}</p>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section id="features" class="features" aria-labelledby="features-heading">
				<h2 id="features-heading" class="features-heading">Current foundation includes</h2>
				<div class="features-grid">
					<article><h3>Rendering</h3><ul><li>Vulkan as a resident rendering API, aiming for a modern approach.</li><li>Customizable, asset and code-driven render graph and render pipeline.</li><li>Shader reflection to reason about shader data at authoring time.</li><li>Materials and full rendering pipeline clustered forward+, with meshlets.</li></ul></article>
					<article><h3>Material &amp; node graphs</h3><ul><li>Build materials visually by connecting typed shader nodes into a surface graph.</li><li>Compile graph assets into GLSL with live preview and parameter controls in the editor.</li><li>The shared graph foundation also supports node-based gameplay and authoring workflows.</li></ul></article>
					<article><h3>Scripting</h3><ul><li>CoreCLR compile server in a separate process; compile and hot-reload in the editor and runtime.</li><li>Potentially: visual scripting, core generation, and additional methods later.</li></ul></article>
					<article><h3>UI System</h3><ul><li>XML/HTML + CSS-style UI.</li><li>Yoga-powered layouts plus extras such as z-index.</li><li>Hot-reload while editing.</li><li>Text rendering uses Slug shaders.</li></ul></article>
					<article><h3>Entity-Component System</h3><ul><li>Modern ECS using C++20 for automatic component registration.</li><li>Write classic systems or code that feels object-oriented while the data layout stays data-oriented.</li><li>Planning to extend with code generation for more optimizations.</li></ul></article>
					<article><h3>Assets</h3><ul><li>Asset database for GUIDs, references, and bookkeeping.</li><li>Asset parsers.</li><li>Live notifications when file contents change.</li></ul></article>
					<article><h3>MCP &amp; LLMs</h3><ul><li>Debug and render introspection with screenshots, CPU/GPU profiling, and render graph capture paths.</li><li>Drive authoring: inspect panels, simulate clicks, and edit entities or components.</li><li>Lifecycle helpers for launch, tests, builds, and verification cycles.</li></ul></article>
					<article><h3>Platform support</h3><ul><li>Native C++ engine and editor builds for Windows, macOS, and Linux.</li><li>Vulkan rendering on Windows and Linux, with Metal support on macOS.</li><li>Managed C# scripting is currently Windows-first, with broader platform support continuing over time.</li></ul></article>
				</div>
			</section>
		</main>

		<OpenEngineFooter />

	</div>
	<div class="editor-lightbox" data-gallery-lightbox hidden role="dialog" aria-modal="true" aria-label="Expanded editor capture">
		<img data-gallery-lightbox-image alt="" />
		<p>Click anywhere to close · Esc</p>
	</div>
</Layout>

<script>
	const editorTour = document.querySelector<HTMLElement>('[data-editor-tour]');
	if (editorTour) {
		const editorStage = editorTour.querySelector<HTMLElement>('.editor-tour-stage');
		const editorImage = editorTour.querySelector<HTMLImageElement>('.editor-tour-image');
		const magnifier = editorTour.querySelector<HTMLElement>('[data-editor-magnifier]');
		const magnifierLabel = editorTour.querySelector<HTMLElement>('[data-editor-magnifier-label]');
		const panels = Array.from(editorTour.querySelectorAll<HTMLElement>('[data-editor-panel]'));
		const editorFeatureLabels: Record<string, string> = {
			hierarchy: 'Hierarchy',
			scene: 'Scene view',
			inspector: 'Inspector',
		assets: 'Asset browser',
		'asset-view': 'Asset view',
		'play-controls': 'Play controls',
		'top-toolbar': 'Top toolbar',
		'layout-presets': 'Layout presets',
		'scene-toolbar': 'Scene toolbar',
		transform: 'Transform',
		'asset-name': 'Asset name',
		'asset-type': 'Asset type',
		'asset-size': 'Asset size',
		'asset-dimensions': 'Asset dimensions',
		'asset-modified': 'Modified date',
		'asset-status': 'Git status',
		'asset-tag': 'Asset tag',
		};
		function activateEditorSection(id: string) {
			panels.forEach((panel) => { panel.hidden = panel.dataset.editorPanel !== id; });
		}

		if (editorStage && editorImage && magnifier) {
			type EditorHitRegion = {
				id: string;
				xMin: number;
				xMax: number;
				yMin: number;
				yMax: number;
			};
			const editorHitRegions: EditorHitRegion[] = [
				// Small, specific controls come first so larger surrounding panels cannot claim them.
				{ id: 'play-controls', xMin: 0.455, xMax: 0.535, yMin: 0.025, yMax: 0.075 },
				{ id: 'layout-presets', xMin: 0.415, xMax: 0.585, yMin: 0.965, yMax: 1 },
				{ id: 'scene-toolbar', xMin: 0.198, xMax: 0.228, yMin: 0.155, yMax: 0.31 },
				{ id: 'transform', xMin: 0.82, xMax: 0.985, yMin: 0.08, yMax: 0.225 },
				{ id: 'assets', xMin: 0, xMax: 0.125, yMin: 0.755, yMax: 0.965 },
				{ id: 'asset-name', xMin: 0.125, xMax: 0.24, yMin: 0.755, yMax: 0.965 },
				{ id: 'asset-type', xMin: 0.24, xMax: 0.285, yMin: 0.755, yMax: 0.965 },
				{ id: 'asset-size', xMin: 0.285, xMax: 0.335, yMin: 0.755, yMax: 0.965 },
				{ id: 'asset-dimensions', xMin: 0.335, xMax: 0.405, yMin: 0.755, yMax: 0.965 },
				{ id: 'asset-modified', xMin: 0.405, xMax: 0.49, yMin: 0.755, yMax: 0.965 },
				{ id: 'asset-status', xMin: 0.49, xMax: 0.54, yMin: 0.755, yMax: 0.965 },
				{ id: 'asset-tag', xMin: 0.54, xMax: 0.575, yMin: 0.755, yMax: 0.965 },
				{ id: 'asset-view', xMin: 0.575, xMax: 0.8, yMin: 0.755, yMax: 0.965 },
				{ id: 'top-toolbar', xMin: 0, xMax: 1, yMin: 0, yMax: 0.075 },
				{ id: 'hierarchy', xMin: 0, xMax: 0.2, yMin: 0.075, yMax: 0.755 },
				{ id: 'inspector', xMin: 0.8, xMax: 1, yMin: 0.075, yMax: 1 },
				{ id: 'scene', xMin: 0.2, xMax: 0.8, yMin: 0.075, yMax: 0.755 },
			];

			function sectionAtPointer(event: PointerEvent) {
				const bounds = editorStage.getBoundingClientRect();
				const x = Math.max(0, Math.min((event.clientX - bounds.left) / bounds.width, 1));
				const y = Math.max(0, Math.min((event.clientY - bounds.top) / bounds.height, 1));
				const region = editorHitRegions.find((candidate) => x >= candidate.xMin
					&& x < candidate.xMax
					&& y >= candidate.yMin
					&& y < candidate.yMax);
				return region?.id || 'scene';
			}

			function updateMagnifier(event: PointerEvent) {
				if (event.pointerType === 'touch' || !editorImage.naturalWidth) return;
				const bounds = editorStage.getBoundingClientRect();
				const x = Math.max(0, Math.min(event.clientX - bounds.left, bounds.width));
				const y = Math.max(0, Math.min(event.clientY - bounds.top, bounds.height));
				const sourceX = x * (editorImage.naturalWidth / bounds.width);
				const sourceY = y * (editorImage.naturalHeight / bounds.height);
				const lensSize = magnifier.offsetWidth;

				magnifier.style.left = `${x}px`;
				magnifier.style.top = `${y}px`;
				magnifier.style.backgroundImage = `url("${editorImage.currentSrc || editorImage.src}")`;
				magnifier.style.backgroundSize = `${editorImage.naturalWidth}px ${editorImage.naturalHeight}px`;
				magnifier.style.backgroundPosition = `${lensSize / 2 - sourceX}px ${lensSize / 2 - sourceY}px`;
				magnifier.classList.add('is-visible');
				if (magnifierLabel) {
					magnifierLabel.style.left = `${x}px`;
					magnifierLabel.style.top = `${y}px`;
					magnifierLabel.textContent = editorFeatureLabels[sectionAtPointer(event)];
					magnifierLabel.classList.add('is-visible');
				}
			}

			editorStage.addEventListener('pointermove', updateMagnifier);
			editorStage.addEventListener('pointermove', (event) => {
				if (event.pointerType === 'touch') return;
				activateEditorSection(sectionAtPointer(event));
			});
			editorStage.addEventListener('pointerleave', () => {
				magnifier.classList.remove('is-visible');
				magnifierLabel?.classList.remove('is-visible');
			});
		}
	}

	const galleryLightbox = document.querySelector<HTMLElement>('[data-gallery-lightbox]');
	const galleryLightboxImage = galleryLightbox?.querySelector<HTMLImageElement>('[data-gallery-lightbox-image]');
	let lastGalleryFocus: HTMLElement | null = null;

	function closeGalleryLightbox() {
		if (!galleryLightbox || galleryLightbox.hidden) return;
		galleryLightbox.hidden = true;
		document.body.style.overflow = '';
		lastGalleryFocus?.focus();
	}

	function openGalleryLightbox(image: HTMLImageElement, trigger: HTMLElement) {
		if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
		if (!galleryLightbox || !galleryLightboxImage) return;
		lastGalleryFocus = trigger;
		galleryLightboxImage.src = image.currentSrc || image.src;
		galleryLightboxImage.alt = image.alt;
		galleryLightbox.hidden = false;
		document.body.style.overflow = 'hidden';
	}

	galleryLightbox?.addEventListener('click', closeGalleryLightbox);
	window.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeGalleryLightbox();
	});

	function clearGalleryMagnifiers(except?: HTMLElement) {
		document.querySelectorAll<HTMLElement>('[data-gallery-magnifier]').forEach((otherMagnifier) => {
			if (otherMagnifier === except) return;
			otherMagnifier.classList.remove('is-visible');
			otherMagnifier.style.backgroundImage = 'none';
			otherMagnifier.parentElement?.classList.remove('is-magnifier-active');
			otherMagnifier.parentElement?.querySelector<HTMLElement>('[data-gallery-magnifier-label]')?.classList.remove('is-visible');
		});
	}

	document.querySelectorAll<HTMLElement>('[data-gallery-stage]').forEach((stage) => {
		const image = stage.querySelector<HTMLImageElement>('[data-gallery-image]');
		const magnifier = stage.querySelector<HTMLElement>('[data-gallery-magnifier]');
		const magnifierLabel = stage.querySelector<HTMLElement>('[data-gallery-magnifier-label]');
		if (!image || !magnifier) return;

		stage.addEventListener('pointerenter', () => {
			clearGalleryMagnifiers(magnifier);
			stage.classList.add('is-magnifier-active');
		});
		stage.addEventListener('pointermove', (event) => {
			if (event.pointerType === 'touch' || !image.naturalWidth) return;
			clearGalleryMagnifiers(magnifier);
			stage.classList.add('is-magnifier-active');
			const bounds = stage.getBoundingClientRect();
			const x = Math.max(0, Math.min(event.clientX - bounds.left, bounds.width));
			const y = Math.max(0, Math.min(event.clientY - bounds.top, bounds.height));
			const sourceX = x * (image.naturalWidth / bounds.width);
			const sourceY = y * (image.naturalHeight / bounds.height);
			const lensSize = magnifier.offsetWidth;

			magnifier.style.left = `${x}px`;
			magnifier.style.top = `${y}px`;
			magnifier.style.backgroundImage = `url("${image.currentSrc || image.src}")`;
			magnifier.style.backgroundSize = `${image.naturalWidth}px ${image.naturalHeight}px`;
			magnifier.style.backgroundPosition = `${lensSize / 2 - sourceX}px ${lensSize / 2 - sourceY}px`;
			magnifier.classList.add('is-visible');
			if (magnifierLabel) {
				const zone = event.target instanceof Element ? event.target.closest<HTMLElement>('.editor-gallery-zone') : null;
				magnifierLabel.style.left = `${x}px`;
				magnifierLabel.style.top = `${y}px`;
				magnifierLabel.textContent = zone?.textContent?.trim() || 'Editor view';
				magnifierLabel.classList.add('is-visible');
			}
		});
		stage.addEventListener('pointerleave', () => {
			magnifier.classList.remove('is-visible');
			magnifier.style.backgroundImage = 'none';
			magnifierLabel?.classList.remove('is-visible');
			stage.classList.remove('is-magnifier-active');
		});
		stage.addEventListener('click', () => openGalleryLightbox(image, stage));
		stage.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			openGalleryLightbox(image, stage);
		});
	});
</script>

<style define:vars={{ markerMask, listBulletMask }}>
	.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	.features-page { --page-pad-left: max(clamp(14px, 4.5vw, 80px), env(safe-area-inset-left, 0px)); --page-pad-right: max(clamp(14px, 4.5vw, 80px), env(safe-area-inset-right, 0px)); --editor-image-info-gap: 14px; min-height: 100dvh; position: relative; isolation: isolate; padding: 0 var(--page-pad-right) max(clamp(28px, 6vw, 48px), env(safe-area-inset-bottom, 0px)) var(--page-pad-left); overflow-x: clip; background: #000; }
	.features-page > :global(:not(.constellation-canvas):not(.page-gradient-layer)) { position: relative; z-index: 2; }
	.features-page > :global(.constellation-canvas) { z-index: 1; }
