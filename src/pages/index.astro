---
import Layout from '../layouts/Layout.astro';
import OpenEngineSiteNav from '../components/OpenEngineSiteNav.astro';
import ConstellationBackground from '../components/ConstellationBackground.astro';
import OpenEngineFooter from '../components/OpenEngineFooter.astro';
---

<Layout title="Open Engine · openengineproject.com">
	<div class="home-page">
		<OpenEngineSiteNav current="home" />
		<ConstellationBackground />

		<main class="home-hero" aria-labelledby="landing-heading">
			<div class="home-copy">
				<p class="eyebrow">Open Engine · Game engine</p>
				<h1 id="landing-heading">Open Engine</h1>
				<p class="intro">A real-time MIT licenced engine for building worlds, designing gameplay, and bringing your games to life.</p>
				<div class="hero-links" aria-label="Explore Open Engine" data-constellation-clear="54">
					<a href="/features">Explore features <span aria-hidden="true">↗</span></a>
					<a href="/roadmap">View roadmap <span aria-hidden="true">↗</span></a>
				</div>
			</div>

			<div class="cube-stage" data-cube-stage role="button" tabindex="0" aria-label="Open Engine cube logo. Drag to rotate it, or activate to play a random animation.">
				<canvas class="cube-canvas" data-cube-canvas aria-hidden="true"></canvas>
			</div>

		</main>

			<section class="engine-principles" aria-label="Engine foundations">
				<ul class="principles-grid">
					<li>
						<span>01 · Rendering</span>
						<h3>GPU-driven from the start</h3>
						<p>Bindless, GPU-driven rendering with Vulkan first-class on Windows and Linux, and Metal first-class on macOS.</p>
					</li>
					<li>
						<span>02 · Shading</span>
						<h3>Physically based</h3>
						<p>PBR materials with OpenPBR support, shaders, image-based lighting, and real-world light values form the default rendering workflow.</p>
					</li>
					<li>
						<span>03 · Runtime</span>
						<h3>Data-oriented ECS</h3>
						<p>A data-oriented entity-component stack is the default, built for clear composition, scheduling, and scale.</p>
					</li>
					<li>
						<span>04 · Interface</span>
						<h3>Data-driven UI</h3>
						<p>XML/HTML structure and CSS-style presentation support fast iteration with live editing and hot reload.</p>
					</li>
					<li>
						<span>05 · Scripting</span>
						<h3>C# or C++</h3>
						<p>The editor detects user code, compiles CoreCLR-backed C# or native C++, and keeps iteration moving with hot reload.</p>
					</li>
					<li>
						<span>06 · Extensibility</span>
						<h3>Packages and plugins</h3>
						<p>Jolt Physics integration ships as a core engine package, but can be swapped out through packages.</p>
					</li>
					<li>
						<span>07 · Post FX</span>
						<h3>Cinematic post-processing</h3>
						<p>Post-processing stack for bloom, tonemapping, exposure, film simulation, depth of field, lens flares, chromatic aberration, and stylized painting effects.</p>
					</li>
					<li>
						<span>08 · UI toolkit</span>
						<h3>Interface built to iterate</h3>
						<p>Yoga-powered layouts, CSS-style presentation, layered controls, Slug text rendering, and hot reload support responsive game interfaces.</p>
					</li>
				</ul>
			</section>

			<figure class="home-editor-preview">
				<a href="/features" aria-label="Explore the Open Engine editor">
					<img
						src="/images/editor-captures/ocean-ibl-workspace.png"
						alt="Open Engine editor showing a sailing ship at sea beneath a purple evening sky."
						loading="lazy"
						decoding="async"
					/>
					<figcaption>Explore the editor <span aria-hidden="true">↗</span></figcaption>
				</a>
			</figure>

		<OpenEngineFooter />
	</div>

	<script>
		import * as THREE from 'three';

		const homePage = document.querySelector<HTMLElement>('.home-page');
		if (homePage) {
			const widescreenAspect = 16 / 9;
			const compactAspect = 2.45;

			const clampLayoutValue = (value: number, minimum: number, maximum: number) => Math.min(Math.max(value, minimum), maximum);
			const interpolate = (start: number, end: number, progress: number) => start + (end - start) * progress;
			const pixels = (value: number) => `${value.toFixed(3)}px`;

			const updateWideLayout = () => {
				const viewportWidth = window.innerWidth;
				const viewportHeight = Math.max(window.innerHeight, 1);
				const aspectRatio = viewportWidth / viewportHeight;
				const progress = clampLayoutValue((aspectRatio - widescreenAspect) / (compactAspect - widescreenAspect), 0, 1);

				const baseRowGap = clampLayoutValue(viewportWidth * 0.06, 32, 104);
				const baseCubeHeight = Math.min(viewportWidth * 0.56, 700);
				const compactCubeHeight = Math.min(baseCubeHeight, viewportHeight * 0.55, 540);
				const baseCardsPadding = clampLayoutValue(viewportWidth * 0.06, 48, 88) + 1;
				const compactCardsPadding = (baseCardsPadding - 1) * 0.65 + 1;

				homePage.style.setProperty('--home-hero-row-gap', pixels(interpolate(baseRowGap, 0, progress)));
				homePage.style.setProperty('--home-cube-stage-height', pixels(interpolate(baseCubeHeight, compactCubeHeight, progress)));
				homePage.style.setProperty('--engine-principles-padding-top', pixels(interpolate(baseCardsPadding, compactCardsPadding, progress)));
			};

			updateWideLayout();
			window.addEventListener('resize', updateWideLayout, { passive: true });
			window.addEventListener('pagehide', () => {
				window.removeEventListener('resize', updateWideLayout);
			}, { once: true });
		}

		const canvas = document.querySelector<HTMLCanvasElement>('[data-cube-canvas]');
		const stage = document.querySelector<HTMLElement>('[data-cube-stage]');

		if (canvas && stage) {
			const scene = new THREE.Scene();
			const camera = new THREE.OrthographicCamera(-2.4, 2.4, 2.4, -2.4, 0.1, 100);
			camera.position.set(5, 5, 5);
			camera.lookAt(0, 0, 0);

			const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
			renderer.setClearColor(0x000000, 0);
			renderer.outputColorSpace = THREE.SRGBColorSpace;
			renderer.toneMapping = THREE.ACESFilmicToneMapping;
			renderer.toneMappingExposure = 1.05;

			function makeLogoTexture(colors: { topLeft: string; topRight: string; bottomLeft: string; bottomRight: string; center: string }) {
				const textureCanvas = document.createElement('canvas');
				textureCanvas.width = 256;
				textureCanvas.height = 256;
				const context = textureCanvas.getContext('2d');
				if (!context) return new THREE.Texture();
				const parse = (color: string) => [1, 3, 5].map((offset) => Number.parseInt(color.slice(offset, offset + 2), 16));
				const [topLeft, topRight, bottomLeft, bottomRight, center] = [colors.topLeft, colors.topRight, colors.bottomLeft, colors.bottomRight, colors.center].map(parse);
				const image = context.createImageData(256, 256);
				for (let y = 0; y < 256; y += 1) {
					const v = y / 255;
					for (let x = 0; x < 256; x += 1) {
						const u = x / 255;
						const centerDistance = Math.hypot(u - 0.5, v - 0.5);
						const centerMix = Math.pow(Math.max(0, 1 - centerDistance / 0.68), 2);
						const index = (y * 256 + x) * 4;
						for (let channel = 0; channel < 3; channel += 1) {
							const top = topLeft[channel] * (1 - u) + topRight[channel] * u;
							const bottom = bottomLeft[channel] * (1 - u) + bottomRight[channel] * u;
							const base = top * (1 - v) + bottom * v;
							image.data[index + channel] = Math.round(base * (1 - centerMix) + center[channel] * centerMix);
						}
						image.data[index + 3] = 255;
					}
				}
				context.putImageData(image, 0, 0);
				const texture = new THREE.CanvasTexture(textureCanvas);
				texture.colorSpace = THREE.SRGBColorSpace;
				texture.anisotropy = Math.min(renderer.capabilities.getMaxAnisotropy(), 8);
				return texture;
			}

			const topTexture = makeLogoTexture({ topLeft: '#fc29ef', topRight: '#feeab3', bottomLeft: '#df96fb', bottomRight: '#a4f5ec', center: '#f1c7c3' });
			const leftTexture = makeLogoTexture({ topLeft: '#ffe8b9', topRight: '#fc69f1', bottomLeft: '#9d9aff', bottomRight: '#8cb9ff', center: '#ea98e6' });
			const rightTexture = makeLogoTexture({ topLeft: '#ffe8bb', topRight: '#b0fac7', bottomLeft: '#a09dff', bottomRight: '#79dfff', center: '#ced9ea' });
			const faceMaterial = (map: THREE.Texture) => new THREE.MeshBasicMaterial({ map, color: 0xffffff, toneMapped: false });

			const logo = new THREE.Group();
			const geometry = new THREE.BoxGeometry(2.05, 2.05, 2.05);
			const materials = [
				faceMaterial(rightTexture),
				faceMaterial(leftTexture),
				faceMaterial(topTexture),
				faceMaterial(leftTexture),
				faceMaterial(leftTexture),
				faceMaterial(rightTexture),
			];
			materials.forEach((material) => {
				material.transparent = true;
				material.opacity = 0;
				material.depthWrite = false;
			});
			const cube = new THREE.Mesh(geometry, materials);
			cube.visible = false;
			const edgeMaterial = new THREE.MeshBasicMaterial({ color: 0xffffff, toneMapped: false, transparent: true, opacity: 0 });
			const edgeGeometry = new THREE.CylinderGeometry(0.025, 0.025, 1, 10);
			const cornerGeometry = new THREE.SphereGeometry(0.027, 10, 8);
			const edgeFrame = new THREE.Group();
			const half = 1.025;
			const corners = [
				new THREE.Vector3(-half, -half, -half), new THREE.Vector3(half, -half, -half),
				new THREE.Vector3(half, half, -half), new THREE.Vector3(-half, half, -half),
				new THREE.Vector3(-half, -half, half), new THREE.Vector3(half, -half, half),
				new THREE.Vector3(half, half, half), new THREE.Vector3(-half, half, half),
			];
			const edgePairs = [[0, 1], [1, 2], [2, 3], [3, 0], [4, 5], [5, 6], [6, 7], [7, 4], [0, 4], [1, 5], [2, 6], [3, 7]];
			const up = new THREE.Vector3(0, 1, 0);
			edgePairs.forEach(([startIndex, endIndex]) => {
				const start = corners[startIndex];
				const end = corners[endIndex];
				const direction = new THREE.Vector3().subVectors(end, start);
				const edge = new THREE.Mesh(edgeGeometry, edgeMaterial);
				edge.position.copy(start).add(end).multiplyScalar(0.5);
				edge.scale.y = direction.length();
				edge.quaternion.setFromUnitVectors(up, direction.normalize());
				edgeFrame.add(edge);
			});
			corners.forEach((position) => {
				const corner = new THREE.Mesh(cornerGeometry, edgeMaterial);
				corner.position.copy(position);
				edgeFrame.add(corner);
			});
			edgeFrame.visible = false;

			const fragmentGeometry = new THREE.BoxGeometry(0.62, 0.62, 0.62);
			const fragmentMaterials = materials.map((material) => {
				const fragmentMaterial = material.clone();
				fragmentMaterial.opacity = 1;
				fragmentMaterial.depthWrite = true;
				return fragmentMaterial;
			});
			const fragmentGroup = new THREE.Group();
			const fragmentStep = 2.05 / 3;
			let fragmentIndex = 0;
			for (let gridX = -1; gridX <= 1; gridX += 1) {
				for (let gridY = -1; gridY <= 1; gridY += 1) {
					for (let gridZ = -1; gridZ <= 1; gridZ += 1) {
						const targetPosition = new THREE.Vector3(gridX, gridY, gridZ).multiplyScalar(fragmentStep);
						const seed = fragmentIndex + 1;
						const scatter = new THREE.Vector3(
							Math.sin(seed * 2.17),
							Math.cos(seed * 1.31) * 0.78,
							Math.sin(seed * 0.91 + 1.2),
						).normalize().multiplyScalar(1.65 + (seed % 5) * 0.24);
						const startPosition = targetPosition.clone().add(scatter);
						const startRotation = new THREE.Euler(seed * 0.47, seed * 0.33, seed * 0.21);
						const fragment = new THREE.Mesh(fragmentGeometry, fragmentMaterials);
						fragment.position.copy(startPosition);
						fragment.rotation.copy(startRotation);
						fragment.scale.setScalar(0.45);
						fragment.userData = { startPosition, targetPosition, startRotation };
						fragmentGroup.add(fragment);
						fragmentIndex += 1;
					}
				}
			}

			const effectGroup = new THREE.Group();
			effectGroup.add(cube, edgeFrame, fragmentGroup);
			logo.add(effectGroup);
			const baseRotation = { x: -0.08, y: -0.08 };
			logo.rotation.set(baseRotation.x, baseRotation.y, 0);
			scene.add(logo);

			const glow = new THREE.PointLight(0xaeeeff, 12, 14, 2);
			glow.position.set(4, 4, 5);
			const fill = new THREE.PointLight(0xf29adf, 7, 11, 2);
			fill.position.set(-3, -1, 4);
			scene.add(new THREE.HemisphereLight(0xd7efff, 0x24335e, 2.25), glow, fill);

			let pointerX = 0;
			let pointerY = 0;
			let mouseFxEnabled = document.documentElement.dataset.mouseFx !== 'off';
			let easedPointerX = 0;
			let easedPointerY = 0;
			let orbitAngle = 0;
			let isHovering = false;
			let hoverAmount = 0;
			let pointerOrientationAmount = 0;
			let pointerBounds = stage.getBoundingClientRect();
			let pointerFollowVelocityX = 0;
			let pointerFollowVelocityY = 0;
			let dragRotationX = 0;
			let dragRotationY = 0;
			let targetDragRotationX = 0;
			let targetDragRotationY = 0;
			let isDragging = false;
			let didDrag = false;
			let draggedPointerId: number | null = null;
			let dragStartClientX = 0;
			let dragStartClientY = 0;
			let dragStartRotationX = 0;
			let dragStartRotationY = 0;
			let cursorVelocityX = 0;
			let cursorVelocityY = 0;
			let lastClientX: number | null = null;
			let lastClientY: number | null = null;
			let lastPointerTime = 0;
			const reactionTypes = ['spin', 'flip', 'bounce', 'pulse', 'wobble'] as const;
			type ReactionType = typeof reactionTypes[number];
			type ActiveReaction = {
				type: ReactionType;
				startedAt: number;
				startPosition: THREE.Vector3;
				startQuaternion: THREE.Quaternion;
				startScale: THREE.Vector3;
			};
			let activeReaction: ActiveReaction | null = null;
			let lastReactionIndex = -1;
			let frame = 0;
			const clock = new THREE.Clock();
			const reactionDurations: Record<ReactionType, number> = { spin: 1.05, flip: 1.05, bounce: 0.9, pulse: 0.78, wobble: 1.2 };
			const reactionPosition = new THREE.Vector3();
			const reactionQuaternion = new THREE.Quaternion();
			const reactionScale = new THREE.Vector3(1, 1, 1);
			const reactionEuler = new THREE.Euler();
			const reactionYAxis = new THREE.Vector3(0, 1, 0);
			const reactionZAxis = new THREE.Vector3(0, 0, 1);

			function playRandomReaction() {
				if (clock.elapsedTime < 2) return;
				let nextIndex = Math.floor(Math.random() * reactionTypes.length);
				if (nextIndex === lastReactionIndex) nextIndex = (nextIndex + 1) % reactionTypes.length;
				lastReactionIndex = nextIndex;
				activeReaction = {
					type: reactionTypes[nextIndex],
					startedAt: clock.elapsedTime,
					startPosition: effectGroup.position.clone(),
					startQuaternion: effectGroup.quaternion.clone(),
					startScale: effectGroup.scale.clone(),
				};
			}

			function resize() {
				pointerBounds = stage.getBoundingClientRect();
				const { width, height } = pointerBounds;
				if (width <= 0 || height <= 0) return;
				const aspect = width / height;
				const viewSize = 4.8;
				const viewWidth = aspect >= 1 ? viewSize * aspect : viewSize;
				const viewHeight = aspect >= 1 ? viewSize : viewSize / aspect;
				renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
				renderer.setSize(width, height, false);
				camera.left = -viewWidth / 2;
				camera.right = viewWidth / 2;
				camera.top = viewHeight / 2;
				camera.bottom = -viewHeight / 2;
				camera.updateProjectionMatrix();
				renderer.render(scene, camera);
			}

			function render() {
				const delta = Math.min(clock.getDelta(), 0.05);
				const introProgress = Math.min(clock.elapsedTime / 2, 1);
				const introEase = 1 - Math.pow(1 - introProgress, 3);
				const finalBlend = Math.max(0, Math.min((introProgress - 0.82) / 0.18, 1));
				if (introProgress < 1) {
					fragmentGroup.children.forEach((child) => {
						const fragment = child as THREE.Mesh;
						const { startPosition, targetPosition, startRotation } = fragment.userData as { startPosition: THREE.Vector3; targetPosition: THREE.Vector3; startRotation: THREE.Euler };
						fragment.position.lerpVectors(startPosition, targetPosition, introEase);
						fragment.rotation.set(startRotation.x * (1 - introEase), startRotation.y * (1 - introEase), startRotation.z * (1 - introEase));
						fragment.scale.setScalar(0.45 + introEase * 0.55);
					});
					fragmentMaterials.forEach((material) => { material.opacity = 1 - finalBlend; });
					cube.visible = finalBlend > 0;
					edgeFrame.visible = finalBlend > 0;
					materials.forEach((material) => { material.opacity = finalBlend; });
					edgeMaterial.opacity = finalBlend;
				} else if (fragmentGroup.visible) {
					fragmentGroup.visible = false;
					cube.visible = true;
					edgeFrame.visible = true;
					orbitAngle = 0;
					easedPointerX = 0;
					easedPointerY = 0;
					materials.forEach((material) => {
						material.opacity = 1;
						material.transparent = false;
						material.depthWrite = true;
						material.needsUpdate = true;
					});
					edgeMaterial.opacity = 1;
				}
				if (introProgress >= 1) {
					const hoverBlend = 1 - Math.exp(-delta * 5.5);
					const dragBlend = 1 - Math.exp(-delta * (isDragging ? 28 : 12));
					const pointerSpring = 18;
					const pointerDamping = Math.exp(-delta * 7);
					hoverAmount += (((mouseFxEnabled && isHovering) ? 1 : 0) - hoverAmount) * hoverBlend;
					pointerOrientationAmount += (((mouseFxEnabled && isHovering && !isDragging) ? 1 : 0) - pointerOrientationAmount) * (1 - Math.exp(-delta * 14));
					orbitAngle += delta * THREE.MathUtils.lerp(0.23, 0.44, hoverAmount);
					pointerFollowVelocityX += (pointerX - easedPointerX) * pointerSpring * delta;
					pointerFollowVelocityY += (pointerY - easedPointerY) * pointerSpring * delta;
					pointerFollowVelocityX *= pointerDamping;
					pointerFollowVelocityY *= pointerDamping;
					easedPointerX = THREE.MathUtils.clamp(easedPointerX + pointerFollowVelocityX * delta, -1.15, 1.15);
					easedPointerY = THREE.MathUtils.clamp(easedPointerY + pointerFollowVelocityY * delta, -1.15, 1.15);
					dragRotationX += (targetDragRotationX - dragRotationX) * dragBlend;
					dragRotationY += (targetDragRotationY - dragRotationY) * dragBlend;
				}
				logo.rotation.y = baseRotation.y + orbitAngle + dragRotationY + easedPointerX * 1.16 * pointerOrientationAmount;
				logo.rotation.x = baseRotation.x + dragRotationX + easedPointerY * 0.68 * pointerOrientationAmount;
				logo.rotation.z = 0;
				effectGroup.position.set(0, 0, 0);
				effectGroup.quaternion.identity();
				effectGroup.scale.setScalar(1);
				if (activeReaction) {
					const duration = reactionDurations[activeReaction.type];
					const reactionAge = clock.elapsedTime - activeReaction.startedAt;
					const progress = Math.min(reactionAge / duration, 1);
					const eased = progress < 0.5 ? 4 * progress * progress * progress : 1 - Math.pow(-2 * progress + 2, 3) / 2;
					const wave = Math.sin(Math.PI * progress);
					reactionPosition.set(0, 0, 0);
					reactionQuaternion.identity();
					reactionScale.set(1, 1, 1);
					switch (activeReaction.type) {
						case 'spin':
							reactionQuaternion.setFromAxisAngle(reactionYAxis, eased * Math.PI * 2);
							break;
						case 'flip':
							reactionEuler.set(eased * Math.PI * 2, wave * 0.22, 0);
							reactionQuaternion.setFromEuler(reactionEuler);
							break;
						case 'bounce':
							reactionPosition.y = wave * 0.72;
							reactionQuaternion.setFromAxisAngle(reactionZAxis, Math.sin(progress * Math.PI * 2) * 0.16);
							reactionScale.set(1 + wave * 0.06, 1 - wave * 0.08, 1 + wave * 0.06);
							break;
						case 'pulse':
							reactionScale.setScalar(1 + wave * 0.3);
							reactionQuaternion.setFromAxisAngle(reactionYAxis, wave * 0.28);
							break;
						case 'wobble': {
							const decay = 1 - progress;
							reactionEuler.set(Math.cos(progress * Math.PI * 7) * 0.17 * decay, 0, Math.sin(progress * Math.PI * 9) * 0.3 * decay);
							reactionQuaternion.setFromEuler(reactionEuler);
							break;
						}
					}
					const handoffProgress = Math.min(reactionAge / 0.12, 1);
					const handoffEase = 1 - Math.pow(1 - handoffProgress, 3);
					effectGroup.position.lerpVectors(activeReaction.startPosition, reactionPosition, handoffEase);
					effectGroup.quaternion.slerpQuaternions(activeReaction.startQuaternion, reactionQuaternion, handoffEase);
					effectGroup.scale.lerpVectors(activeReaction.startScale, reactionScale, handoffEase);
					if (progress >= 1) activeReaction = null;
				}
				renderer.render(scene, camera);
				frame = requestAnimationFrame(render);
			}

			function trackPointerVelocity(event: PointerEvent) {
				if (event.pointerType === 'touch') return;
				if (!mouseFxEnabled) return;
				if (lastClientX !== null && lastClientY !== null && lastPointerTime > 0) {
					const elapsedSinceMove = Math.max((event.timeStamp - lastPointerTime) / 1000, 0);
					if (elapsedSinceMove > 0.12) {
						cursorVelocityX = 0;
						cursorVelocityY = 0;
					} else {
						const elapsed = THREE.MathUtils.clamp(elapsedSinceMove, 1 / 240, 0.08);
						const instantVelocityX = ((event.clientX - lastClientX) / Math.max(pointerBounds.width, 1)) / elapsed;
						const instantVelocityY = ((event.clientY - lastClientY) / Math.max(pointerBounds.height, 1)) / elapsed;
						const velocityBlend = 1 - Math.exp(-elapsed * 18);
						cursorVelocityX += (instantVelocityX - cursorVelocityX) * velocityBlend;
						cursorVelocityY += (instantVelocityY - cursorVelocityY) * velocityBlend;
					}
				}
				lastClientX = event.clientX;
				lastClientY = event.clientY;
				lastPointerTime = event.timeStamp;
			}

			window.addEventListener('pointermove', trackPointerVelocity, { passive: true });
			const updatePointerOrientation = (event: PointerEvent) => {
				pointerX = THREE.MathUtils.clamp(((event.clientX - pointerBounds.left) / pointerBounds.width - 0.5) * 2, -1, 1);
				pointerY = THREE.MathUtils.clamp(((event.clientY - pointerBounds.top) / pointerBounds.height - 0.5) * 2, -1, 1);
			};
			stage.addEventListener('pointermove', (event) => {
				if (event.pointerType === 'touch') return;
				if (mouseFxEnabled && !isDragging) updatePointerOrientation(event);
				if (!isDragging || event.pointerId !== draggedPointerId) return;
				const dragX = (event.clientX - dragStartClientX) / Math.max(pointerBounds.width, 1);
				const dragY = (event.clientY - dragStartClientY) / Math.max(pointerBounds.height, 1);
				if (Math.hypot(event.clientX - dragStartClientX, event.clientY - dragStartClientY) > 5) didDrag = true;
				targetDragRotationY = dragStartRotationY + dragX * Math.PI * 1.45;
				targetDragRotationX = THREE.MathUtils.clamp(dragStartRotationX + dragY * Math.PI * 0.9, -0.9, 0.9);
			});
			stage.addEventListener('pointerenter', (event) => {
				isHovering = mouseFxEnabled;
				if (!mouseFxEnabled) return;
				updatePointerOrientation(event);
				if (clock.elapsedTime < 2) return;
				const velocityAge = lastPointerTime > 0 ? Math.max((event.timeStamp - lastPointerTime) / 1000, 0) : 1;
				const recentVelocity = Math.exp(-velocityAge * 18);
				pointerFollowVelocityX = THREE.MathUtils.clamp(pointerFollowVelocityX + cursorVelocityX * 0.28 * recentVelocity, -2.4, 2.4);
