---
import Layout from '../../layouts/Layout.astro';
import OpenEngineSiteNav from '../../components/OpenEngineSiteNav.astro';
import ConstellationBackground from '../../components/ConstellationBackground.astro';
import PageGradientLayer from '../../components/PageGradientLayer.astro';
import DocCardIcon from '../../components/DocCardIcon.astro';
import OpenEngineFooter from '../../components/OpenEngineFooter.astro';
import { readFile } from 'node:fs/promises';

const docsDescription =
	'Technical references for the Open Engine CLI, editor, rendering, scripting, animation, engine systems, and contributor workflows.';

const markdownDocument = (
	number: string,
	type: string,
	title: string,
	description: string,
	basePath: string,
) => ({
	number,
	type,
	format: 'HTML + Markdown',
	title,
	description,
	href: `${basePath}.html`,
	sourceHref: `${basePath}.md`,
	sourceLabel: 'Markdown source',
});

const htmlDocument = (
	number: string,
	type: string,
	title: string,
	description: string,
	href: string,
) => ({
	number,
	type,
	format: 'HTML',
	title,
	description,
	href,
	sourceHref: null,
	sourceLabel: null,
});

const documents = [
	markdownDocument('01', 'Getting started', 'Game Engine user guide', 'An introduction to projects, scenes, entities, components, assets, scripting, and the editor workflow.', '/docs/getting-started/user-guide'),
	htmlDocument('02', 'Getting started', 'GameEngine CLI manual', 'Control and inspect the editor, automate scenes and UI, capture rendering diagnostics, author source, and run build and test workflows from the command line.', '/docs/getting-started/cli-manual.html'),
	{
		number: '03',
		type: 'Editor UI',
		format: 'HTML + Markdown',
		title: 'UI component library',
		description: 'Browse the controls, CSS classes, tokens, layout patterns, icon conventions, and authoring rules already available in the editor.',
		href: '/docs/editor/ui_component_library.html',
		sourceHref: '/docs/editor/ui_component_library.md',
		sourceLabel: 'Markdown source',
	},
	markdownDocument('04', 'Editor UI', 'UI guidelines', 'Practical guidance for clear and consistent editor interfaces, from layout and styling to interaction behavior.', '/docs/editor/ui-guidelines'),
	markdownDocument('05', 'Editor UI', 'Editor keyboard shortcuts', 'A compact reference for navigating and operating the editor efficiently from the keyboard.', '/docs/editor/keyboard-shortcuts'),
	markdownDocument('06', 'Editor UI', 'Smart Folders', 'Build dynamic asset collections using saved filters and editor-aware project organization.', '/docs/editor/smart-folders'),
	markdownDocument('07', 'Editor UI', 'UI API guide', 'Create native editor interfaces with UI elements, layouts, styles, events, and reusable controls.', '/docs/editor/ui-api-guide'),
	htmlDocument('08', 'Editor UI', 'Timeline API manual', 'Author time-based editor tools and animation workflows with the timeline API.', '/docs/editor/timeline-api.html'),
	htmlDocument('09', 'Editor UI', 'Unified playback API', 'Use the shared playback model for timelines, previews, animation, and editor transport controls.', '/docs/editor/unified-playback-api.html'),
	markdownDocument('10', 'Rendering', 'HDR post-processing', 'Configure HDR output, bloom, exposure, tonemapping, and the post-processing pipeline.', '/docs/rendering/hdr-post-processing'),
	markdownDocument('11', 'Rendering', 'Custom render pipeline', 'Build asset-driven rendering pipelines with RenderGraph resources, passes, and pipeline defaults.', '/docs/rendering/custom-render-pipeline'),
	markdownDocument('12', 'Rendering', 'Sky rendering', 'Work with the physical sky, dynamic environment lighting, and scene atmosphere.', '/docs/rendering/sky-rendering'),
	markdownDocument('13', 'Rendering', 'RenderGraph quick reference', 'Declare rendering resources, passes, dependencies, and execution through RenderGraph.', '/docs/rendering/render-graph'),
	htmlDocument('14', 'Rendering', 'Shader graph specification', 'Technical specification for shader graph data, node files, connections, and compilation.', '/docs/rendering/shader-graph-spec.html'),
	htmlDocument('15', 'Rendering', 'Rendering architecture guide', 'Explore the GPU-driven renderer, resource model, frame flow, and architectural boundaries.', '/docs/rendering/architecture-guide.html'),
	markdownDocument('16', 'Rendering', 'GPU debugging and profiling', 'Capture and profile frames with RenderDoc, NVIDIA Nsight, and AMD Radeon GPU Profiler.', '/docs/rendering/gpu-debugging-and-profiling'),
	htmlDocument('17', 'Rendering', 'Render pipeline authoring', 'Create and configure render pipelines using the engine authoring model.', '/docs/rendering/render-pipeline-authoring.html'),
	markdownDocument('18', 'Scripting', 'Scripting architecture', 'Understand managed scripting, compilation, assembly loading, and asynchronous hot reload.', '/docs/scripting/overview'),
	markdownDocument('19', 'Scripting', 'C# play mode, input, and ECS', 'Create C# gameplay systems that integrate with play mode, input, entities, and components.', '/docs/scripting/csharp-play-mode-ecs'),
	markdownDocument('20', 'Scripting', 'Hot reload best practices', 'Structure scripts and state so iteration remains fast and reliable during hot reload.', '/docs/scripting/hot-reload'),
	markdownDocument('21', 'Animation', 'Humanoid retargeting quickstart', 'Get a humanoid retargeting workflow running from source rig to animated target.', '/docs/animation/quickstart'),
	markdownDocument('22', 'Animation', 'Humanoid retargeting overview', 'Learn the concepts, workflow, and responsibilities behind the retargeting system.', '/docs/animation/overview'),
	markdownDocument('23', 'Animation', 'Humanoid retargeting architecture', 'Technical architecture for rigs, mappings, runtime data, and animation processing.', '/docs/animation/architecture'),
	markdownDocument('24', 'Animation', 'Humanoid retargeting API', 'Reference the main retargeting types, configuration, and API surface.', '/docs/animation/api-reference'),
	markdownDocument('25', 'Engine systems', 'Entity component system', 'Guidance for entities, components, queries, systems, scheduling, and data-oriented workflows.', '/docs/engine-systems/entity-component-system'),
	markdownDocument('26', 'Engine systems', 'Physics events', 'Use collision and trigger events from gameplay systems through the Physics ECS integration.', '/docs/engine-systems/physics-events'),
	markdownDocument('27', 'Engine systems', 'Input system', 'Understand device input, action state, frame updates, and the input module architecture.', '/docs/engine-systems/input-system'),
	markdownDocument('28', 'Contributors', 'Build and test', 'Configure, build, test, and validate the engine and editor across supported development environments.', '/docs/contributors/build-and-test'),
	markdownDocument('29', 'Contributors', 'Coding style', 'Follow the project conventions for readable, maintainable C++ and shared engine code.', '/docs/contributors/coding-style'),
];

const searchableWords = (value: string) => (
	[...new Set(
		value
			.replace(/<!--[\s\S]*?-->/g, ' ')
			.replace(/<script[\s\S]*?<\/script>/gi, ' ')
			.replace(/<style[\s\S]*?<\/style>/gi, ' ')
			.replace(/<[^>]+>/g, ' ')
			.replace(/&(?:[a-z]+|#\d+);/gi, ' ')
			.toLocaleLowerCase()
			.match(/[a-z0-9+#._-]{2,}/g) ?? [],
	)]
);

const documentSearchIndex = Object.fromEntries(await Promise.all(
	documents.map(async (document) => {
		let source = '';
		const candidates = [document.sourceHref, document.href].filter(
			(candidate): candidate is string => Boolean(candidate),
		);

		for (const candidate of candidates) {
			try {
				source = await readFile(
					new URL(`../../../public${candidate}`, import.meta.url),
					'utf8',
				);
				break;
			} catch {
				// Some HTML-only references have no Markdown source.
			}
		}

		return [
			document.href,
			searchableWords(`${document.title} ${document.description} ${source}`).join(' '),
		];
	}),
));

const treeSections = [
	{
		label: 'Getting started',
		cardIcon: '01',
		cardType: 'Getting started',
		open: true,
		items: [
			{ label: 'Documentation overview', href: '/docs', current: true },
			{ label: 'Game Engine user guide', href: '/docs/getting-started/user-guide.html' },
			{ label: 'GameEngine CLI manual', href: '/docs/getting-started/cli-manual.html' },
			{ label: 'Build & test', href: '/docs/contributors/build-and-test.html' },
			{ label: 'Coding style', href: '/docs/contributors/coding-style.html' },
		],
	},
	{
		label: 'Editor & UI',
		cardIcon: '03',
		cardType: 'Editor UI',
		open: true,
		items: [
			{ label: 'Component library', href: '/docs/editor/ui_component_library.html' },
			{ label: 'UI guidelines', href: '/docs/editor/ui-guidelines.html' },
			{ label: 'Keyboard shortcuts', href: '/docs/editor/keyboard-shortcuts.html' },
			{ label: 'Smart Folders', href: '/docs/editor/smart-folders.html' },
			{ label: 'UI API guide', href: '/docs/editor/ui-api-guide.html' },
			{ label: 'Timeline API', href: '/docs/editor/timeline-api.html' },
			{ label: 'Unified playback API', href: '/docs/editor/unified-playback-api.html' },
		],
	},
	{
		label: 'Rendering',
		cardIcon: '13',
		cardType: 'Rendering',
		items: [
			{ label: 'HDR post-processing', href: '/docs/rendering/hdr-post-processing.html' },
			{ label: 'Custom render pipeline', href: '/docs/rendering/custom-render-pipeline.html' },
			{ label: 'Sky rendering', href: '/docs/rendering/sky-rendering.html' },
			{ label: 'RenderGraph', href: '/docs/rendering/render-graph.html' },
			{ label: 'Shader graph specification', href: '/docs/rendering/shader-graph-spec.html' },
			{ label: 'Rendering architecture', href: '/docs/rendering/architecture-guide.html' },
			{ label: 'GPU debugging & profiling', href: '/docs/rendering/gpu-debugging-and-profiling.html' },
			{ label: 'Pipeline authoring', href: '/docs/rendering/render-pipeline-authoring.html' },
		],
	},
	{
		label: 'Scripting',
		cardIcon: '17',
		cardType: 'Scripting',
		items: [
			{ label: 'Scripting overview', href: '/docs/scripting/overview.html' },
			{ label: 'C# play mode & ECS', href: '/docs/scripting/csharp-play-mode-ecs.html' },
			{ label: 'Hot reload', href: '/docs/scripting/hot-reload.html' },
		],
	},
	{
		label: 'Animation',
		cardIcon: '21',
		cardType: 'Animation',
		items: [
			{ label: 'Quickstart', href: '/docs/animation/quickstart.html' },
			{ label: 'Overview', href: '/docs/animation/overview.html' },
			{ label: 'Architecture', href: '/docs/animation/architecture.html' },
			{ label: 'API reference', href: '/docs/animation/api-reference.html' },
		],
	},
	{
		label: 'Engine systems',
		cardIcon: '24',
		cardType: 'Engine systems',
		items: [
			{ label: 'Entity component system', href: '/docs/engine-systems/entity-component-system.html' },
			{ label: 'Physics events', href: '/docs/engine-systems/physics-events.html' },
			{ label: 'Input system', href: '/docs/engine-systems/input-system.html' },
		],
	},
];
---

<Layout title="Documentation · Open Engine · openengineproject.com" description={docsDescription}>
	<div class="docs-page">
		<OpenEngineSiteNav current="docs" />
		<PageGradientLayer variant="docs" />
		<ConstellationBackground />

		<main>
			<aside class="docs-sidebar" aria-label="Documentation navigation">
				<a class="sidebar-heading" href="/docs" aria-label="Open documentation overview">
					<span class="sidebar-mark">OE</span>
					<div>
						<p>Open Engine</p>
						<strong>Documentation</strong>
					</div>
				</a>
				<div class="docs-search">
					<label for="docs-search-input">
						<span class="search-icon" aria-hidden="true"></span>
						<input
							id="docs-search-input"
							type="search"
							placeholder="Search documentation"
							autocomplete="off"
							spellcheck="false"
						/>
						<button class="search-clear" type="button" aria-label="Clear documentation search" hidden>
							<span aria-hidden="true">×</span>
						</button>
					</label>
					<p class="search-status" aria-live="polite"></p>
				</div>
				<nav class="docs-tree">
					{treeSections.map((section) => (
						<details class="tree-group" open={section.open} data-tree-type={section.label}>
							<summary>
								<span class="tree-chevron" aria-hidden="true"></span>
								<span class="tree-icon" aria-hidden="true">
									<DocCardIcon icon={section.cardIcon} type={section.cardType} compact />
								</span>
								<span class="tree-label">{section.label}</span>
								<span class="tree-count">{section.items.length.toString().padStart(2, '0')}</span>
							</summary>
							<div class="tree-children">
								{section.items.map((item) => (
									item.current ? (
										<button
											class="tree-link active"
											type="button"
											data-doc-overview
											aria-current="page"
										>
											<span class="tree-node" aria-hidden="true"></span>
											{item.label}
										</button>
									) : item.href ? (
										<a
											class="tree-link"
											href={item.href}
											data-doc-link
											data-doc-title={item.label}
										>
											<span class="tree-node" aria-hidden="true"></span>
											{item.label}
										</a>
									) : (
										<span class="tree-link is-pending">
											<span class="tree-node" aria-hidden="true"></span>
											{item.label}
											<em>Soon</em>
										</span>
									)
								))}
							</div>
						</details>
					))}
				</nav>
			</aside>

			<div class="docs-content">
				<div id="docs-overview">
					<header class="docs-hero">
						<p class="eyebrow"><span></span> Open Engine reference</p>
						<h1>Documentation</h1>
						<p class="intro">
							Technical references for command-line workflows, editor tools, and the systems behind Open Engine.
						</p>
					</header>

					<section class="docs-index" aria-label="Engine documentation">
						<div class="docs-grid">
							{documents.map((document) => (
								<article
									class="doc-card"
									role="link"
									tabindex="0"
									aria-label={`Open ${document.title}`}
									data-card-href={document.href}
									data-card-title={document.title}
									data-card-type={document.type}
								>
									<div class="doc-card-topline">
										<span>{document.number} · {document.type}</span>
										<span class="doc-status"><i></i> Published</span>
									</div>
									<DocCardIcon icon={document.number} type={document.type} />
									<h3>{document.title}</h3>
									<p>{document.description}</p>
									<div class="doc-card-footer">
										<a href={document.href} data-doc-link data-doc-title={document.title}>
											Open document <span aria-hidden="true">↗</span>
										</a>
										{document.sourceHref && (
											<a
												class="source-link"
												href={document.sourceHref}
												data-doc-link
												data-doc-title={`${document.title} · Markdown`}
											>
												{document.sourceLabel}
											</a>
										)}
										<span>{document.format}</span>
									</div>
								</article>
							))}
						</div>
					</section>
				</div>

				<section class="document-viewer" id="document-viewer" hidden aria-live="polite">
					<div class="viewer-frame-wrap">
						<div class="viewer-loading" aria-hidden="true">
							<span></span>
							Loading reference
						</div>
						<iframe
							id="docs-frame"
							name="docs-frame"
							title="Open Engine documentation viewer"
							scrolling="no"
						></iframe>
					</div>
				</section>
			</div>
		</main>

		<script
			id="docs-search-index"
			type="application/json"
			set:html={JSON.stringify(documentSearchIndex)}
		></script>

		<OpenEngineFooter />
	</div>
</Layout>

<script>
	const overview = document.querySelector<HTMLElement>('#docs-overview');
	const viewer = document.querySelector<HTMLElement>('#document-viewer');
	const frame = document.querySelector<HTMLIFrameElement>('#docs-frame');
	const viewerLoading = document.querySelector<HTMLElement>('.viewer-loading');
	const docLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-doc-link]')];
	const docCards = [...document.querySelectorAll<HTMLElement>('.doc-card[data-card-href]')];
	const overviewButtons = [...document.querySelectorAll<HTMLElement>('[data-doc-overview]')];
	const treeLinks = [...document.querySelectorAll<HTMLElement>('.docs-tree .tree-link')];
	const treeGroups = [...document.querySelectorAll<HTMLDetailsElement>('.docs-tree .tree-group')];
	const docsSidebar = document.querySelector<HTMLElement>('.docs-sidebar');
	const docsContent = document.querySelector<HTMLElement>('.docs-content');
	const searchInput = document.querySelector<HTMLInputElement>('#docs-search-input');
	const searchClear = document.querySelector<HTMLButtonElement>('.search-clear');
	const searchStatus = document.querySelector<HTMLElement>('.search-status');
	const searchIndexElement = document.querySelector<HTMLScriptElement>('#docs-search-index');
	const docsSearchIndex: Record<string, string> = (() => {
		try {
			return JSON.parse(searchIndexElement?.textContent ?? '{}');
		} catch {
			return {};
		}
	})();
	let frameResizeObserver: ResizeObserver | undefined;
	let preservedTreeScrollTop = 0;
	const docsOverviewScrollKey = 'overview';
	const docsScrollStorageKey = 'openengine-docs-scroll-positions';
	const docsScrollPositions: Record<string, number> = (() => {
		try {
			return JSON.parse(sessionStorage.getItem(docsScrollStorageKey) ?? '{}');
		} catch {
			return {};
		}
	})();
	let activeDocsScrollKey = docsOverviewScrollKey;
	let pendingDocsScrollTop = docsScrollPositions[docsOverviewScrollKey] ?? 0;

	const restoreTreePosition = (scrollTop: number) => {
		if (!docsSidebar) return;
		docsSidebar.scrollTop = scrollTop;
		requestAnimationFrame(() => {
			docsSidebar.scrollTop = scrollTop;
		});
		window.setTimeout(() => {
			docsSidebar.scrollTop = scrollTop;
		}, 0);
	};

	const applyPendingDocsScrollPosition = () => {
		window.scrollTo({
			top: pendingDocsScrollTop,
			left: window.scrollX,
			behavior: 'auto',
		});
	};

	const sizeFrameToContent = () => {
		if (!frame?.contentDocument) return;
		const embeddedDocument = frame.contentDocument;
		const height = Math.max(
			embeddedDocument.documentElement?.scrollHeight ?? 0,
			embeddedDocument.body?.scrollHeight ?? 0,
		);
		if (height > 0) frame.style.height = `${height}px`;
	};

	const normalizedDocPath = (href: string) => {
		const path = new URL(href, window.location.origin).pathname;
		return path.replace(/\.md$/, '.html').replace(/\/+$/, '') || '/';
	};

	const saveActiveDocsScrollPosition = () => {
		const scrollTop = Math.max(0, window.scrollY);
		if (scrollTop > 4) docsScrollPositions[activeDocsScrollKey] = scrollTop;
		else delete docsScrollPositions[activeDocsScrollKey];

		try {
			sessionStorage.setItem(docsScrollStorageKey, JSON.stringify(docsScrollPositions));
		} catch {
			// In-memory scroll restoration still works when storage is unavailable.
		}
	};

	const restoreDocsScrollPosition = (scrollKey: string) => {
		activeDocsScrollKey = scrollKey;
		pendingDocsScrollTop = docsScrollPositions[scrollKey] ?? 0;
		applyPendingDocsScrollPosition();
		requestAnimationFrame(applyPendingDocsScrollPosition);
		window.setTimeout(applyPendingDocsScrollPosition, 0);
	};

	const normalizedSearchText = (value: string) => (
		value.toLocaleLowerCase().replace(/\s+/g, ' ').trim()
	);

	const matchesSearchTerms = (value: string, terms: string[]) => {
		const searchableValue = normalizedSearchText(value);
		return terms.every((term) => searchableValue.includes(term));
	};

	const updateDocsSearch = () => {
		const query = normalizedSearchText(searchInput?.value ?? '');
		const terms = query.split(' ').filter(Boolean);

		treeGroups.forEach((group) => {
			const groupLinks = [...group.querySelectorAll<HTMLElement>('.tree-link')];
			const groupLabel = normalizedSearchText(
				group.querySelector<HTMLElement>('.tree-label')?.textContent ?? '',
			);
			const groupLabelMatches = Boolean(query) && matchesSearchTerms(groupLabel, terms);
			let groupMatches = 0;

			groupLinks.forEach((link) => {
				const linkPath = link instanceof HTMLAnchorElement
					? normalizedDocPath(link.getAttribute('href') ?? '')
					: '';
				const indexedContent = docsSearchIndex[linkPath] ?? '';
				const matches = (
					!query
					|| groupLabelMatches
					|| matchesSearchTerms(`${link.textContent ?? ''} ${indexedContent}`, terms)
				);
				link.hidden = !matches;
				if (matches) groupMatches += 1;
			});

			group.hidden = Boolean(query) && groupMatches === 0;

			if (query) {
				if (!group.hasAttribute('data-search-open')) {
					group.dataset.searchOpen = group.open ? 'true' : 'false';
				}
				if (groupMatches > 0) group.open = true;
			} else if (group.hasAttribute('data-search-open')) {
				group.open = group.dataset.searchOpen === 'true';
				delete group.dataset.searchOpen;
			}
		});

		let matchingCards = 0;
		docCards.forEach((card) => {
			const cardPath = normalizedDocPath(card.dataset.cardHref ?? '');
			const indexedContent = docsSearchIndex[cardPath] ?? '';
			const matches = (
				!query
				|| matchesSearchTerms(`${card.textContent ?? ''} ${indexedContent}`, terms)
			);
			card.hidden = !matches;
			if (matches) matchingCards += 1;
		});

		if (searchClear) searchClear.hidden = !query;
		if (searchStatus) {
			searchStatus.textContent = query
				? `${matchingCards} ${matchingCards === 1 ? 'reference' : 'references'} found`
				: '';
		}

		if (query && matchingCards === 0 && searchStatus) {
			searchStatus.textContent = 'No references found';
		}
	};

	const clearDocsSearch = () => {
		if (!searchInput) return;
		searchInput.value = '';
		updateDocsSearch();
		searchInput.focus();
	};

	const setActiveTreeItem = (href?: string) => {
		const treeScrollTop = docsSidebar?.scrollTop ?? 0;
		const normalizedHref = href ? normalizedDocPath(href) : undefined;
		const activeItem = href
			? treeLinks.find((item) => (
				item instanceof HTMLAnchorElement
				&& normalizedDocPath(item.getAttribute('href') ?? '') === normalizedHref
			))
			: treeLinks.find((item) => item.hasAttribute('data-doc-overview'));

		treeLinks.forEach((item) => {
			const active = item === activeItem;
			item.classList.toggle('active', active);
			if (active) item.setAttribute('aria-current', 'page');
			else item.removeAttribute('aria-current');
		});

		if (activeItem) {
			const group = activeItem.closest<HTMLDetailsElement>('.tree-group');
			if (group) group.open = true;
		}

		restoreTreePosition(treeScrollTop);
	};

	const showOverview = () => {
		if (!overview || !viewer) return;
		saveActiveDocsScrollPosition();
		overview.hidden = false;
		viewer.hidden = true;
		setActiveTreeItem();
		restoreDocsScrollPosition(docsOverviewScrollKey);
	};

	const showDocument = (href: string) => {
		if (!overview || !viewer || !frame) return;
		saveActiveDocsScrollPosition();
		const documentScrollKey = normalizedDocPath(href);
		preservedTreeScrollTop = docsSidebar?.scrollTop ?? 0;
		if (docsContent) docsContent.style.minHeight = `${docsContent.offsetHeight}px`;
		overview.hidden = true;
		viewer.hidden = false;
		viewerLoading?.removeAttribute('hidden');
		frame.style.height = '70dvh';
		frame.src = href;
		setActiveTreeItem(href);
		restoreDocsScrollPosition(documentScrollKey);
	};

	docLinks.forEach((link) => {
		link.addEventListener('click', (event) => {
			event.preventDefault();
			showDocument(link.getAttribute('href') ?? '');
		});
	});

	docCards.forEach((card) => {
		const openCard = () => {
			showDocument(card.dataset.cardHref ?? '');
		};

		card.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) return;
			openCard();
		});

		card.addEventListener('keydown', (event) => {
			if (event.target !== card || (event.key !== 'Enter' && event.key !== ' ')) return;
			event.preventDefault();
			openCard();
		});
	});

	overviewButtons.forEach((button) => button.addEventListener('click', showOverview));
	searchInput?.addEventListener('input', updateDocsSearch);
	searchInput?.addEventListener('search', updateDocsSearch);
	searchClear?.addEventListener('click', clearDocsSearch);
	searchInput?.addEventListener('keydown', (event) => {
