---
import Layout from '../layouts/Layout.astro';
import OpenEngineSiteNav from '../components/OpenEngineSiteNav.astro';
import OpenEngineFooter from '../components/OpenEngineFooter.astro';
import PageGradientLayer from '../components/PageGradientLayer.astro';

type Status = 'in-progress' | 'planned' | 'complete' | 'exploring';
type Category = 'foundation' | 'rendering' | 'editor-ui' | 'gameplay' | 'animation' | 'world' | 'multiplayer' | 'tools' | 'platform';
type Artwork =
	| 'material-graph'
	| 'forward-plus'
	| 'camera'
	| 'culling'
	| 'diagnostics'
	| 'editor-workspace'
	| 'scene-assets'
	| 'ecs'
	| 'asset-database'
	| 'physics'
	| 'scripting'
	| 'ui'
	| 'retargeting'
	| 'timeline'
	| 'terrain'
	| 'atmosphere'
	| 'mcp'
	| 'player'
	| 'platforms'
	| 'multiplayer'
	| 'smart-folders'
	| 'tags'
	| 'git'
	| 'lore'
	| 'subversion'
	| 'diversion';

interface RoadmapItem {
	title: string;
	description: string;
	status: Status;
	category: Category;
	detail: string;
	artwork: Artwork;
}

const statusLabels: Record<Status, string> = {
	'in-progress': 'In progress',
	planned: 'Planned',
	complete: 'Complete',
	exploring: 'Exploring',
};

const categoryLabels: Record<Category, string> = {
	foundation: 'Foundation',
	rendering: 'Rendering',
	'editor-ui': 'Editor & UI',
	gameplay: 'Gameplay & Scripting',
	animation: 'Animation',
	world: 'World building',
	multiplayer: 'Multiplayer',
	tools: 'Tools & AI',
	platform: 'Platform',
};

const items: RoadmapItem[] = [
	{
		title: 'Material & node graphs',
		description: 'Visual material authoring with typed shader nodes, graph assets, GLSL generation, live preview, and a shared foundation for node-based workflows.',
		status: 'in-progress',
		category: 'rendering',
		detail: 'In development',
		artwork: 'material-graph',
	},
	{
		title: 'Forward+ Renderer',
		description: 'Forward+ light culling and clustered shading for many dynamic lights, integrated with the engine’s material and shadow systems.',
		status: 'in-progress',
		category: 'rendering',
		detail: 'Mostly complete',
		artwork: 'forward-plus',
	},
	{
		title: 'Cinematic camera effects',
		description: 'Film simulation, lens flares, physical depth of field, chromatic aberration, and painting-style post-processing.',
		status: 'in-progress',
		category: 'rendering',
		detail: 'Active',
		artwork: 'camera',
	},
	{
		title: 'Transparency & GPU culling',
		description: 'GPU visibility culling, HZB occlusion tests, and transparent draw sorting integrated into the renderer.',
		status: 'complete',
		category: 'rendering',
		detail: 'Shipped',
		artwork: 'culling',
	},
	{
		title: 'Render inspection & profiling',
		description: 'Per-pass GPU timings, CPU scopes, metrics, screenshots, render-graph inspection, and diagnostics tooling.',
		status: 'complete',
		category: 'tools',
		detail: 'Shipped',
		artwork: 'diagnostics',
	},
	{
		title: 'Editor workspace',
		description: 'A dockable visual editor with inspector panels, scene view, search, project tools, shortcuts, and a component library.',
		status: 'complete',
		category: 'editor-ui',
		detail: 'Shipped',
		artwork: 'editor-workspace',
	},
	{
		title: 'Scene & asset workflows',
		description: 'Scene schemas, hierarchy tooling, mesh picking, project folders, thumbnails, importers, and editor-side asset management.',
		status: 'in-progress',
		category: 'editor-ui',
		detail: 'Active',
		artwork: 'scene-assets',
	},
	{
		title: 'Smart Folders',
		description: 'Saved project and global views that collect assets automatically by file type, name, regular expression, tags, and version-control status.',
		status: 'complete',
		category: 'editor-ui',
		detail: 'Shipped',
		artwork: 'smart-folders',
	},
	{
		title: 'Asset tags',
		description: 'Project-defined coloured tags for labeling assets, filtering Smart Folders, and keeping large content libraries easy to navigate.',
		status: 'complete',
		category: 'editor-ui',
		detail: 'Shipped',
		artwork: 'tags',
	},
	{
		title: 'Git version control',
		description: 'Git workspace detection, asset status badges, commits, diffs, logs, and project-aware source-control workflows from the editor.',
		status: 'complete',
		category: 'editor-ui',
		detail: 'Shipped',
		artwork: 'git',
	},
	{
		title: 'Lore version control',
		description: 'Lore integration through the editor’s provider system, with repository detection, status reporting, history, and server-backed update workflows.',
		status: 'complete',
		category: 'editor-ui',
		detail: 'Shipped',
		artwork: 'lore',
	},
	{
		title: 'Subversion version control',
		description: 'Subversion support through the shared source-control provider interface, including repository status, diffs, history, and commit workflows.',
		status: 'complete',
		category: 'editor-ui',
		detail: 'Shipped',
		artwork: 'subversion',
	},
	{
		title: 'Diversion version control',
		description: 'Diversion integration with server-backed status, reviewable changes, history, and update actions available alongside the project assets.',
		status: 'complete',
		category: 'editor-ui',
		detail: 'Shipped',
		artwork: 'diversion',
	},
	{
		title: 'High-performance ECS',
		description: 'C++20 component registration, data-oriented storage, fluent queries, scheduling, and rendering integration.',
		status: 'complete',
		category: 'foundation',
		detail: 'Shipped',
		artwork: 'ecs',
	},
	{
		title: 'Asset database & runtime',
		description: 'GUID-based references, a Git-friendly asset database, parsers, streaming services, derived data, and file watching.',
		status: 'complete',
		category: 'foundation',
		detail: 'Shipped',
		artwork: 'asset-database',
	},
	{
		title: 'Physics, audio & input',
		description: 'Physics ECS with opt-in collision and trigger events, plus native audio and input modules for gameplay systems.',
		status: 'complete',
		category: 'foundation',
		detail: 'Shipped',
		artwork: 'physics',
	},
	{
		title: 'CoreCLR C# scripting',
		description: 'Managed scripting with native interop, a compile server, incremental compilation, and asynchronous hot reload.',
		status: 'complete',
		category: 'gameplay',
		detail: 'Shipped',
		artwork: 'scripting',
	},
	{
		title: 'XML/CSS UI system',
		description: 'XML layouts, CSS-like selectors and variables, Yoga layout, custom controls, events, text rendering, and live reload.',
		status: 'complete',
		category: 'editor-ui',
		detail: 'Shipped',
		artwork: 'ui',
	},
	{
		title: 'GPU humanoid retargeting',
		description: 'GPU-resident cross-rig animation playback for Mixamo, Synty, MetaHuman, glTF, and VRM-style characters, with CPU preview.',
		status: 'in-progress',
		category: 'animation',
		detail: 'Phase 10',
		artwork: 'retargeting',
	},
	{
		title: 'Animation authoring',
		description: 'Animation windows, controllers, graph nodes, skinning support, retargeting samples, and dedicated regression coverage.',
		status: 'in-progress',
		category: 'animation',
		detail: 'Active',
		artwork: 'timeline',
	},
	{
		title: 'Terrain & natural worlds',
		description: 'Terrain, CBT terrain, terrain grass, ocean, splines, and ECS integrations for constructing large environments.',
		status: 'in-progress',
		category: 'world',
		detail: 'Active',
		artwork: 'terrain',
	},
	{
		title: 'Atmosphere & effects',
		description: 'Volumetric and height fog, GPU fog particles, portable particles, text, and lens-flare systems for scene atmosphere.',
		status: 'in-progress',
		category: 'world',
		detail: 'Active',
		artwork: 'atmosphere',
	},
	{
		title: 'Multiplayer foundation',
		description: 'Networking foundations for replicated worlds, entity state synchronization, client/server iteration, and practical multiplayer testing workflows.',
		status: 'planned',
		category: 'multiplayer',
		detail: 'Planned',
		artwork: 'multiplayer',
	},
	{
		title: 'MCP editor automation',
		description: 'An MCP server for driving the editor, querying scenes and ECS, reading logs, capturing screenshots, and running build/test loops.',
		status: 'complete',
		category: 'tools',
		detail: 'Shipped',
		artwork: 'mcp',
	},
	{
		title: 'Standalone Player',
		description: 'A dedicated Player runtime target alongside the Editor, with continued work on packaging and distribution workflows.',
		status: 'in-progress',
		category: 'platform',
		detail: 'Active',
		artwork: 'player',
	},
	{
		title: 'Cross-platform editor',
		description: 'Native C++ Engine and Editor builds across Windows, macOS with Metal support, and Linux. Managed scripting remains Windows-first.',
		status: 'in-progress',
		category: 'platform',
		detail: 'Active',
		artwork: 'platforms',
	},
];

const artworkSvg: Record<Artwork, string> = {
