	'smart-folders': `<svg viewBox="0 0 170 104"><path d="M14 31H69L80 42V83H14Z"/><path d="M14 31V21H62L70 31M31 53H63M31 66H54"/><circle cx="119" cy="46" r="22"/><path d="M135 62L153 80M109 46H129M119 36V56"/></svg>`,
