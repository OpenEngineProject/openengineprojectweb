	lore: `<svg viewBox="0 0 170 104"><path d="M21 22H104C123 22 137 35 137 52S123 82 104 82H21Z"/><path d="M43 38H92M43 52H116M43 66H81"/><circle cx="144" cy="52" r="12"/><path d="M144 35V69M127 52H161"/></svg>`,
	subversion: `<svg viewBox="0 0 170 104"><path d="M24 20H82L101 39V84H24Z"/><path d="M82 20V39H101M40 52H84M40 66H72"/><path d="M122 31C143 31 151 45 151 59C151 75 139 84 122 84C110 84 101 78 96 69"/><path d="M96 69L95 83M96 69L110 71"/></svg>`,
	diversion: `<svg viewBox="0 0 170 104"><circle cx="34" cy="52" r="12"/><circle cx="84" cy="24" r="12"/><circle cx="84" cy="80" r="12"/><circle cx="136" cy="52" r="12"/><path d="M46 52H62C68 52 70 44 74 36M46 52H62C68 52 70 60 74 68M96 24H108C119 24 122 42 124 52M96 80H108C119 80 122 62 124 52"/></svg>`,
};

const countForStatus = (status: Status) => items.filter((item) => item.status === status).length;
const countForCategory = (category: Category) => items.filter((item) => item.category === category).length;
const statuses = (Object.keys(statusLabels) as Status[]).filter((status) => countForStatus(status) > 0);
const categories = Object.keys(categoryLabels) as Category[];
---

<Layout
	title="Roadmap — Open Engine"
	description="Follow the Open Engine roadmap: what is complete, in progress, planned, and still being explored."
	ogTitle="Open Engine Roadmap"
>
	<div class="roadmap-page">
		<OpenEngineSiteNav current="roadmap" />
		<PageGradientLayer variant="roadmap" />
		<canvas class="constellation-canvas" id="constellation-background" aria-hidden="true"></canvas>

		<main>
			<section class="roadmap-board" aria-labelledby="board-heading">
				<div class="board-controls">
					<div class="board-heading">
						<div>
							<p class="section-kicker">Explore the work</p>
							<h2 id="board-heading">Engine initiatives</h2>
						</div>
						<div class="board-actions">
							<p id="result-count" aria-live="polite">Showing all {items.length} initiatives</p>
							<label class="roadmap-search" for="roadmap-search">
								<input id="roadmap-search" type="search" placeholder="Search rendering, editor, multiplayer…" aria-label="Search initiatives" autocomplete="off" spellcheck="false" />
							</label>
						</div>
					</div>

					<div class="filters" aria-label="Roadmap filters">
						<div class="filter-row" role="group" aria-label="Filter by status">
							<button class="filter-chip is-active" type="button" data-filter-group="status" data-filter="all" aria-pressed="true">
								All <span>{items.length}</span>
							</button>
							{statuses.map((status) => (
								<button class={`filter-chip status-${status}`} type="button" data-filter-group="status" data-filter={status} aria-pressed="false">
									<i aria-hidden="true"></i>{statusLabels[status]} <span>{countForStatus(status)}</span>
								</button>
							))}
						</div>

						<div class="filter-row categories" role="group" aria-label="Filter by category">
							<button class="filter-chip is-active" type="button" data-filter-group="category" data-filter="all" aria-pressed="true">
								All systems <span>{items.length}</span>
							</button>
							{categories.map((category) => (
								<button class="filter-chip" type="button" data-filter-group="category" data-filter={category} aria-pressed="false">
									{categoryLabels[category]} <span>{countForCategory(category)}</span>
								</button>
							))}
						</div>

					</div>
				</div>

				<div class="roadmap-grid" id="roadmap-grid">
					{items.map((item, index) => (
						<article class={`roadmap-card card-${index + 1}`} data-status={item.status} data-category={item.category} data-search={[item.title, item.description, item.detail, statusLabels[item.status], categoryLabels[item.category]].join(' ').toLowerCase()}>
							<div class="card-visual" aria-hidden="true">
								<span class="visual-grid"></span>
								<div class={`feature-abstract art-${item.artwork}`} set:html={artworkSvg[item.artwork]}></div>
								<p>{String(index + 1).padStart(2, '0')}</p>
							</div>
							<div class="card-content">
								<div class="card-labels">
									<span class="category-label">{categoryLabels[item.category]}</span>
									<span class={`status-label status-${item.status}`}><i aria-hidden="true"></i>{statusLabels[item.status]}</span>
								</div>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
								<footer>
									<span>{item.detail}</span>
									{item.status === 'complete' && (
										<span class="card-arrow" aria-hidden="true"><img class="card-engine-logo" src="/icons/editor/logo.png" alt="" /></span>
									)}
								</footer>
							</div>
						</article>
					))}
				</div>

				<div class="empty-state" id="empty-state" hidden>
					<p>No initiatives match the current search and filters.</p>
					<button type="button" id="clear-filters">Clear filters</button>
				</div>
			</section>

			<section class="roadmap-note" aria-labelledby="roadmap-note-heading">
				<p class="section-kicker">A living plan</p>
				<h2 id="roadmap-note-heading">The road ahead.</h2>
				<p>
					This roadmap communicates intent, not release dates. Work may move between stages as
					technical discoveries, contributors, and real-world projects shape the engine.
				</p>
				<a href="/github">Follow development on GitHub <span aria-hidden="true">↗</span></a>
			</section>
		</main>

		<OpenEngineFooter />
	</div>

	<script>
		import * as THREE from 'three';

		const filters = { status: 'all', category: 'all', query: '' };
		const buttons = Array.from(document.querySelectorAll('[data-filter-group]'));
		const cards = Array.from(document.querySelectorAll('.roadmap-card'));
		const count = document.querySelector('#result-count');
		const empty = document.querySelector('#empty-state');
		const searchInput = document.querySelector<HTMLInputElement>('#roadmap-search');

		function applyFilters() {
			let visible = 0;
			cards.forEach((card) => {
				if (!(card instanceof HTMLElement)) return;
				const matchesStatus = filters.status === 'all' || card.dataset.status === filters.status;
				const matchesCategory = filters.category === 'all' || card.dataset.category === filters.category;
				const matchesSearch = !filters.query || card.dataset.search?.includes(filters.query);
				card.hidden = !(matchesStatus && matchesCategory && matchesSearch);
				if (!card.hidden) visible += 1;
			});

			if (count) count.textContent = visible === cards.length ? `Showing all ${visible} initiatives` : `Showing ${visible} ${visible === 1 ? 'initiative' : 'initiatives'}`;
			if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
			window.dispatchEvent(new CustomEvent('roadmap:filter-change'));
		}

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				if (!(button instanceof HTMLButtonElement)) return;
				const group = button.dataset.filterGroup;
				const value = button.dataset.filter;
				if ((group !== 'status' && group !== 'category') || !value) return;
				filters[group] = value;
				buttons.forEach((candidate) => {
					if (!(candidate instanceof HTMLButtonElement) || candidate.dataset.filterGroup !== group) return;
					const active = candidate === button;
					candidate.classList.toggle('is-active', active);
					candidate.setAttribute('aria-pressed', String(active));
				});
				applyFilters();
			});
		});

		searchInput?.addEventListener('input', () => {
			filters.query = searchInput.value.trim().toLowerCase();
			applyFilters();
		});

		document.querySelector('#clear-filters')?.addEventListener('click', () => {
			(['status', 'category']).forEach((group) => {
				filters[group] = 'all';
				buttons.forEach((button) => {
					if (!(button instanceof HTMLButtonElement) || button.dataset.filterGroup !== group) return;
					const active = button.dataset.filter === 'all';
					button.classList.toggle('is-active', active);
					button.setAttribute('aria-pressed', String(active));
				});
			});
			filters.query = '';
			if (searchInput) searchInput.value = '';
			applyFilters();
		});

		const constellationCanvas = document.querySelector<HTMLCanvasElement>('#constellation-background');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (constellationCanvas) {
			const renderer = new THREE.WebGLRenderer({ canvas: constellationCanvas, alpha: true, antialias: true });
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
			const scene = new THREE.Scene();
			const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 10);
			camera.position.z = 1;

			const starCount = window.innerWidth < 720 ? 34 : 62;
			const driftSpeed = reducedMotion ? 0.02 : 0.065;
			const starPositions = new Float32Array(starCount * 3);
			const starTargets = new Float32Array(starCount * 2);
			const starVelocity = new Float32Array(starCount * 2);
			const starGeometry = new THREE.BufferGeometry();
			const starMaterial = new THREE.PointsMaterial({
				color: 0x9eeeff,
				size: 2.6,
				transparent: true,
				opacity: 0.72,
				sizeAttenuation: false,
			});

			let viewportWidth = 1;
			let viewportHeight = 1;
			let scrollParallax = window.scrollY * 0.035;
			let pointerActive = false;
			let pointerX = 0;
			let pointerY = 0;
			let mouseFxEnabled = document.documentElement.dataset.mouseFx !== 'off';
			const protectedSelector = [
				'a', 'button', 'input', 'select', 'textarea', 'summary', 'article',
				'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'span', 'small', 'strong',
				'em', 'label', 'li', 'dt', 'dd', 'th', 'td', 'blockquote', 'code', 'pre',
				'[class*="-card"]', '[role="button"]', '[role="link"]', '[contenteditable="true"]',
			].join(', ');
			const protectedPadding = 44;
			let protectedBounds: DOMRect[] = [];

			function refreshProtectedBounds() {
				protectedBounds = Array.from(document.querySelectorAll<HTMLElement>(protectedSelector))
					.map((element) => element.getBoundingClientRect())
					.filter((bounds) => bounds.width > 0 && bounds.height > 0);
			}

			function isNearProtectedSurface(clientX: number, clientY: number, target: EventTarget | null) {
				if (target instanceof Element && target.closest(protectedSelector)) return true;
				return protectedBounds.some((bounds) => clientX >= bounds.left - protectedPadding
					&& clientX <= bounds.right + protectedPadding
					&& clientY >= bounds.top - protectedPadding
					&& clientY <= bounds.bottom + protectedPadding);
			}

			for (let index = 0; index < starCount; index += 1) {
				const positionIndex = index * 3;
				starPositions[positionIndex] = (Math.random() - 0.5) * window.innerWidth;
				starPositions[positionIndex + 1] = (Math.random() - 0.5) * window.innerHeight;
				starTargets[index * 2] = starPositions[positionIndex];
				starTargets[index * 2 + 1] = starPositions[positionIndex + 1];
				starVelocity[index * 2] = (Math.random() - 0.5) * driftSpeed;
				starVelocity[index * 2 + 1] = (Math.random() - 0.5) * driftSpeed;
			}

			starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
			scene.add(new THREE.Points(starGeometry, starMaterial));

			const maxConnections = starCount * 3;
			const linePositions = new Float32Array(maxConnections * 6);
			const lineGeometry = new THREE.BufferGeometry();
			lineGeometry.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
			lineGeometry.setDrawRange(0, 0);
			const lineMaterial = new THREE.LineBasicMaterial({
				color: 0x63c8ff,
				transparent: true,
				opacity: 0.26,
			});
			scene.add(new THREE.LineSegments(lineGeometry, lineMaterial));

			const cursorLinePositions = new Float32Array(6);
			const cursorLineGeometry = new THREE.BufferGeometry();
			cursorLineGeometry.setAttribute('position', new THREE.BufferAttribute(cursorLinePositions, 3));
			cursorLineGeometry.setDrawRange(0, 0);
			const cursorLineMaterial = new THREE.LineBasicMaterial({
				color: 0xa6edff,
				transparent: true,
				opacity: 0.58,
			});
			scene.add(new THREE.LineSegments(cursorLineGeometry, cursorLineMaterial));

			type PlacedStar = { id: number; x: number; y: number; velocityX: number; velocityY: number; anchorIndex: number; anchorPlacedId: number | null };
			const maxPlacedStars = window.innerWidth < 720 ? 18 : 32;
			const placedStars: PlacedStar[] = [];
			let nextPlacedStarId = 1;
			const placedStarPositions = new Float32Array(maxPlacedStars * 3);
			const placedStarGeometry = new THREE.BufferGeometry();
			placedStarGeometry.setAttribute('position', new THREE.BufferAttribute(placedStarPositions, 3));
			placedStarGeometry.setDrawRange(0, 0);
			const placedStarMaterial = new THREE.PointsMaterial({ color: 0xd7f7ff, size: 3.2, transparent: true, opacity: 0.92, sizeAttenuation: false });
			scene.add(new THREE.Points(placedStarGeometry, placedStarMaterial));

			const placedLinePositions = new Float32Array(maxPlacedStars * 6);
			const placedLineGeometry = new THREE.BufferGeometry();
			placedLineGeometry.setAttribute('position', new THREE.BufferAttribute(placedLinePositions, 3));
			placedLineGeometry.setDrawRange(0, 0);
			const placedLineMaterial = new THREE.LineBasicMaterial({ color: 0x7cdfff, transparent: true, opacity: 0.46 });
			scene.add(new THREE.LineSegments(placedLineGeometry, placedLineMaterial));
			let rerouteFrames = 0;

			function rerouteConstellation() {
				for (let index = 0; index < starCount; index += 1) {
					starTargets[index * 2] = (Math.random() - 0.5) * viewportWidth;
					starTargets[index * 2 + 1] = (Math.random() - 0.5) * viewportHeight;
				}
				rerouteFrames = 72;
				refreshProtectedBounds();
			}

			function resizeConstellation() {
				viewportWidth = window.innerWidth;
				viewportHeight = window.innerHeight;
				renderer.setSize(viewportWidth, viewportHeight, false);
				camera.left = -viewportWidth / 2;
				camera.right = viewportWidth / 2;
				camera.top = viewportHeight / 2;
				camera.bottom = -viewportHeight / 2;
				camera.updateProjectionMatrix();
				refreshProtectedBounds();
			}

			function drawConstellation() {
				let connectionCount = 0;
				camera.position.y = -scrollParallax;
				const connectionDistance = Math.max(96, Math.min(viewportWidth, viewportHeight) * 0.17);
				const connectionDistanceSquared = connectionDistance * connectionDistance;

				for (let index = 0; index < starCount; index += 1) {
					const positionIndex = index * 3;
					starPositions[positionIndex] += starVelocity[index * 2];
					starPositions[positionIndex + 1] += starVelocity[index * 2 + 1];
					if (rerouteFrames > 0) {
						starPositions[positionIndex] += (starTargets[index * 2] - starPositions[positionIndex]) * 0.06;
						starPositions[positionIndex + 1] += (starTargets[index * 2 + 1] - starPositions[positionIndex + 1]) * 0.06;
					}

					if (Math.abs(starPositions[positionIndex]) > viewportWidth / 2) starVelocity[index * 2] *= -1;
					if (Math.abs(starPositions[positionIndex + 1]) > viewportHeight / 2) starVelocity[index * 2 + 1] *= -1;

					for (let nextIndex = index + 1; nextIndex < starCount && connectionCount < maxConnections; nextIndex += 1) {
						const nextPositionIndex = nextIndex * 3;
						const dx = starPositions[positionIndex] - starPositions[nextPositionIndex];
						const dy = starPositions[positionIndex + 1] - starPositions[nextPositionIndex + 1];
						if (dx * dx + dy * dy > connectionDistanceSquared) continue;

						const lineIndex = connectionCount * 6;
						linePositions[lineIndex] = starPositions[positionIndex];
						linePositions[lineIndex + 1] = starPositions[positionIndex + 1];
						linePositions[lineIndex + 2] = 0;
						linePositions[lineIndex + 3] = starPositions[nextPositionIndex];
						linePositions[lineIndex + 4] = starPositions[nextPositionIndex + 1];
						linePositions[lineIndex + 5] = 0;
						connectionCount += 1;
					}
				}
				if (rerouteFrames > 0) rerouteFrames -= 1;

				starGeometry.attributes.position.needsUpdate = true;
				lineGeometry.attributes.position.needsUpdate = true;
				lineGeometry.setDrawRange(0, connectionCount * 2);

				let placedStarCount = 0;
				let placedLineCount = 0;
				for (const star of mouseFxEnabled ? placedStars : []) {
					star.x += star.velocityX;
					star.y += star.velocityY;
					const positionIndex = placedStarCount * 3;
					placedStarPositions[positionIndex] = star.x;
					placedStarPositions[positionIndex + 1] = star.y;
					placedStarCount += 1;

					const lineIndex = placedLineCount * 6;
					placedLinePositions[lineIndex] = star.x;
					placedLinePositions[lineIndex + 1] = star.y;
					const placedAnchor = star.anchorPlacedId === null ? undefined : placedStars.find((candidate) => candidate.id === star.anchorPlacedId);
					if (placedAnchor) {
						placedLinePositions[lineIndex + 3] = placedAnchor.x;
						placedLinePositions[lineIndex + 4] = placedAnchor.y;
					} else {
						const anchorPositionIndex = star.anchorIndex * 3;
						placedLinePositions[lineIndex + 3] = starPositions[anchorPositionIndex];
						placedLinePositions[lineIndex + 4] = starPositions[anchorPositionIndex + 1];
					}
					placedLineCount += 1;
				}
				placedStarGeometry.attributes.position.needsUpdate = true;
				placedStarGeometry.setDrawRange(0, placedStarCount);
				placedLineGeometry.attributes.position.needsUpdate = true;
				placedLineGeometry.setDrawRange(0, placedLineCount * 2);

				if (mouseFxEnabled && pointerActive) {
					const cursorWorldX = pointerX - viewportWidth / 2;
					const cursorWorldY = viewportHeight / 2 - pointerY - scrollParallax;
					let nearestIndex = 0;
					let nearestDistance = Infinity;

					for (let index = 0; index < starCount; index += 1) {
						const positionIndex = index * 3;
						const dx = starPositions[positionIndex] - cursorWorldX;
						const dy = starPositions[positionIndex + 1] - cursorWorldY;
						const distance = dx * dx + dy * dy;
						if (distance < nearestDistance) {
							nearestDistance = distance;
							nearestIndex = positionIndex;
						}
					}

					cursorLinePositions[0] = starPositions[nearestIndex];
					cursorLinePositions[1] = starPositions[nearestIndex + 1];
					cursorLinePositions[3] = cursorWorldX;
					cursorLinePositions[4] = cursorWorldY;
					cursorLineGeometry.attributes.position.needsUpdate = true;
					cursorLineGeometry.setDrawRange(0, 2);
				} else {
					cursorLineGeometry.setDrawRange(0, 0);
				}
				renderer.render(scene, camera);
			}

			let animationFrame = 0;
			function animateConstellation() {
				if (document.hidden) return;
				drawConstellation();
				animationFrame = window.requestAnimationFrame(animateConstellation);
			}

			window.addEventListener('resize', resizeConstellation, { passive: true });
			window.addEventListener('scroll', () => {
				scrollParallax = window.scrollY * 0.035;
				refreshProtectedBounds();
			}, { passive: true });
			window.addEventListener('pointermove', (event) => {
				if (event.pointerType === 'touch') return;
				if (!mouseFxEnabled) {
					pointerActive = false;
					return;
				}
				if (isNearProtectedSurface(event.clientX, event.clientY, event.target)) {
					pointerActive = false;
					return;
				}
				pointerActive = true;
				pointerX = event.clientX;
				pointerY = event.clientY;
			}, { passive: true });
			window.addEventListener('click', (event) => {
				if (!mouseFxEnabled) return;
				if (!(event instanceof MouseEvent) || event.button !== 0 || event.defaultPrevented) return;
				const target = event.target;
				if (!(target instanceof Element)) return;
				if (isNearProtectedSurface(event.clientX, event.clientY, target)) return;

				const centerX = event.clientX - viewportWidth / 2;
				const centerY = viewportHeight / 2 - event.clientY - scrollParallax;
				let anchorIndex = 0;
				let anchorDistance = Infinity;
				let anchorPlacedId: number | null = null;
				for (let index = 0; index < starCount; index += 1) {
					const positionIndex = index * 3;
					const dx = starPositions[positionIndex] - centerX;
					const dy = starPositions[positionIndex + 1] - centerY;
					const distance = dx * dx + dy * dy;
					if (distance < anchorDistance) {
						anchorDistance = distance;
						anchorIndex = index;
					}
				}
				for (const star of placedStars) {
					const dx = star.x - centerX;
					const dy = star.y - centerY;
					const distance = dx * dx + dy * dy;
					if (distance < anchorDistance) {
						anchorDistance = distance;
						anchorPlacedId = star.id;
					}
				}
				const lastPlacedStar = placedStars[placedStars.length - 1];
				if (lastPlacedStar) {
					const dx = lastPlacedStar.x - centerX;
					const dy = lastPlacedStar.y - centerY;
					if (dx * dx + dy * dy <= 190 * 190) anchorPlacedId = lastPlacedStar.id;
				}

				placedStars.push({
					id: nextPlacedStarId,
					x: centerX,
					y: centerY,
					velocityX: (Math.random() - 0.5) * driftSpeed * 0.7,
					velocityY: (Math.random() - 0.5) * driftSpeed * 0.7,
					anchorIndex,
					anchorPlacedId,
				});
				nextPlacedStarId += 1;
				if (placedStars.length > maxPlacedStars) placedStars.shift();
			});
			document.addEventListener('pointerout', (event) => {
				if (!event.relatedTarget) pointerActive = false;
			});
			window.addEventListener('blur', () => { pointerActive = false; });
			window.addEventListener('openengine:mouse-fx-change', (event) => {
				const detail = (event as CustomEvent<{ enabled?: boolean }>).detail;
				mouseFxEnabled = detail?.enabled !== false;
				if (!mouseFxEnabled) pointerActive = false;
			});
			window.addEventListener('roadmap:filter-change', rerouteConstellation);
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) window.cancelAnimationFrame(animationFrame);
				else animateConstellation();
			});
			resizeConstellation();
			drawConstellation();
			animateConstellation();
		}
	</script>
</Layout>

