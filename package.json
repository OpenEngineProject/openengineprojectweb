{
  "name": "starlight",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run sync:engine-docs && astro dev",
    "sync:engine-docs": "node scripts/sync-engine-docs.mjs",
    "sync:editor-icons": "node scripts/sync-editor-icons.mjs",
    "sync:editor-icons:png": "node scripts/sync-editor-icons.mjs --png",
    "sync:catalog-gallery": "npm run sync:editor-icons:png && npm run sync:engine-docs",
    "build": "astro build",
    "build:site": "npm run sync:engine-docs && npm run build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "astro": "^7.1.3",
    "three": "^0.185.1"
  }
}
